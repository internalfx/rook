# systemd unit for running ROOK as a service. Copy it to /etc/systemd/system/rook.service, change
# the three paths and the user to match your install, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now rook
#   journalctl -u rook -f

[Unit]
Description=ROOK planner and assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The account that owns the checkout and its data/ folder
User=rook
Group=rook
# Where the repository is checked out
WorkingDirectory=/opt/rook
# Bun's install location for that user (`which bun`)
ExecStart=/home/rook/.bun/bin/bun run app.js
Restart=on-failure
RestartSec=5
# Production mode: the login cookie is only sent over HTTPS, so put a TLS proxy in front
Environment=ROOK_ENV=production
# Behind that proxy, so the client's address comes from X-Forwarded-For
Environment=ROOK_TRUST_PROXY=true
# The defaults are port 8005 on every address; change them here if needed
# Environment=ROOK_PORT=8005
# Environment=ROOK_HOST=127.0.0.1

[Install]
WantedBy=multi-user.target
