{
  "name": "rook",
  "version": "0.1.0",
  "description": "A planner and personal assistant that runs on your own models",
  "license": "MIT",
  "repository": "github:internalfx/rook",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "app": "bun run app.js",
    "dev": "bun --watch run app.js",
    "css": "tailwindcss -i ./assets/application.css -o ./dist/application.css --minify",
    "devcss": "tailwindcss -i ./assets/application.css -o ./dist/application.css --watch",
    "lint": "eslint --ext .js app.js substruct.js configure.js lib services middleware routes scripts ai-tools"
  },
  "dependencies": {
    "@koa/cors": "5.0.0",
    "@mixmark-io/domino": "2.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/forms": "^0.5.11",
    "cuid": "^3.0.0",
    "dayjs": "^1.11.23",
    "inquirer": "^9.3.8",
    "joi": "17.13.1",
    "koa": "3.0.1",
    "koa-body": "6.0.1",
    "koa-ratelimit": "6.0.0",
    "lodash": "^4.18.1",
    "lru-cache": "^10.4.3",
    "mime-types": "3.0.2",
    "mkdirp": "3.0.1",
    "node-cron": "3.0.3",
    "numeral": "^2.0.6",
    "nunjucks": "^3.2.4",
    "puppeteer": "25.16.0",
    "puppeteer-extra": "3.3.6",
    "puppeteer-extra-plugin-stealth": "2.11.2",
    "rou3": "^0.5.1",
    "tailwindcss": "^4.3.3",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  },
  "devDependencies": {
    "eslint": "10.14.0",
    "eslint-config-standard": "17.0.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-n": "15.6.1",
    "eslint-plugin-promise": "6.1.1"
  }
}
