{% extends "layouts/minimal" %}

{% block body %}
<div class="bg-white rounded-lg shadow-md p-8 lg:p-12 space-y-5">
  <h1 class="text-xl font-bold">ROOK has no accounts yet</h1>
  <p class="text-sm text-gray-700">Setup in the browser is turned off on this server, so no one who reaches this address can make the first account. Make it on the server instead, in a terminal inside ROOK's folder or container:</p>
  <pre class="text-sm bg-gray-100 rounded-md px-4 py-3 overflow-x-auto"><code>bun scripts/users.js</code></pre>
  <p class="text-sm text-gray-700">Choose <span class="font-medium">Add a user</span>. The first account is the admin's. Then log in here, and set the Lemonade server and the models on the Admin pages.</p>
</div>
{% endblock body %}
