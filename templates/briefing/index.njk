{% extends 'layouts/default' %}

{% block head %}
{% include 'partials/runMessagesScript' %}
<script>
  document.addEventListener(`alpine:init`, () => {
    // The model writes Markdown => HTML that's safe to put in the page, as chat replies are
    Alpine.magic(`markdown`, () => function (text) {
      return runMessages.renderMarkdown(text)
    })

    // The running briefing as it goes: its replies, with their thinking, and its tool calls,
    // drawn as a chat's are. Everything it has done so far comes first, so a page opened part
    // way catches up. When it ends, the page reloads to show it finished.
    Alpine.data(`briefingRun`, () => ({
      ...runMessages,
      messages: [],

      init () {
        this.watch()
      },

      // Watches until the briefing ends, then reloads to show it. If the stream is cut off (the
      // page is being left, or the server restarted) it watches again after a moment. Reloading
      // then would take the place of a link just clicked: Safari cuts a page's requests off as
      // soon as it starts leaving.
      async watch () {
        while (true) {
          try {
            const response = await fetch(`/briefing/stream`)
            // Everything so far comes again
            this.messages = []
            await this.readStream(response)
            break
          } catch (err) {
            await new Promise((resolve) => setTimeout(resolve, 2000))
          }
        }

        window.location.reload()
      },

      // The briefing is a stream of rook's own events, one JSON object per "data:" line (see
      // runBriefing in services/briefings.js), as a chat's reply is
      async readStream (response) {
        const reader = response.body.getReader()
        const decoder = new TextDecoder()
        let buffer = ``

        while (true) {
          const { value, done } = await reader.read()

          if (done) {
            break
          }

          buffer += decoder.decode(value, { stream: true })

          const lines = buffer.split(`\n`)
          // The last piece may be half a line; keep it for the next chunk
          buffer = lines.pop()

          const shouldScroll = this.isNearBottom()

          for (const line of lines) {
            this.readEvent(line)
          }

          if (shouldScroll) {
            this.scrollToBottom()
          }
        }
      },

      // Its replies and tool calls. An error shows on the briefing once it has finished, and
      // "finished" (it ended before the page started watching) ends the stream, so both are
      // left to the reload.
      readEvent (line) {
        const trimmed = line.trim()

        if (trimmed.startsWith(`data:`) === false) {
          return
        }

        const event = JSON.parse(trimmed.slice(5))
        runMessages.applyRunEvent(this.messages, event)
      },

      // True while it's waiting on the model with nothing new to show: before its first reply
      // (it's reading what it's given), during a reply's thinking, and after a tool's result
      isWaiting () {
        const last = this.messages[this.messages.length - 1]

        if (last == null) {
          return true
        }

        if (last.role === `assistant`) {
          return last.content === ``
        }

        return last.pending === false
      },

      isNearBottom () {
        const el = this.$refs.messages
        const distanceFromBottom = el.scrollHeight - el.scrollTop - el.clientHeight
        return distanceFromBottom < 80
      },

      scrollToBottom () {
        this.$nextTick(() => {
          const el = this.$refs.messages
          el.scrollTop = el.scrollHeight
        })
      },
    }))

    // A finished briefing's transcript, from the page's JSON (see routes/briefing/index.js)
    Alpine.data(`briefingTranscript`, () => ({
      ...runMessages,
      messages: [],

      init () {
        const transcripts = JSON.parse(document.getElementById(`briefing-transcripts`).textContent)
        this.messages = transcripts[this.$el.dataset.briefingId] ?? []
      },
    }))
  })
</script>
{% endblock %}

{% block body %}
<script type="application/json" id="briefing-transcripts">{{ transcriptsJSON | safe }}</script>

  {# A briefing's overview, with Discuss, and what it did #}
  {% macro briefingBody(briefing) %}
    {% if briefing.status == 'failed' %}
      <div class="m-4 p-4 text-sm rounded-lg border border-red-200 bg-red-50 text-red-800" role="alert">
        This briefing didn't finish: {{ briefing.error }}
      </div>
    {% endif %}

    {% if briefing.overview %}
      <div class="markdown px-4 py-3 text-sm break-words" x-html="$markdown($el.dataset.text)" data-text="{{ briefing.overview }}">{{ briefing.overview }}</div>

      {# Opens a new chat with the overview as the model's first message #}
      <form method="post" action="/briefing/{{ briefing.id }}/discuss" class="px-4 pb-3">
        <button type="submit" class="flex items-center gap-1.5 px-3 py-1.5 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-md">
          <span class="icon-chat inline-block size-4 bg-current" aria-hidden="true"></span>
          Discuss
        </button>
      </form>
    {% elif briefing.status == 'done' %}
      <p class="px-4 py-3 text-sm text-gray-500">It didn't write an overview.</p>
    {% endif %}

    {# Its thinking and tool calls, as they looked while it ran; a step is a tool call #}
    {% if briefing.transcript.length > 0 %}
      <details class="border-t border-gray-100" x-data="briefingTranscript" data-briefing-id="{{ briefing.id }}">
        <summary class="px-4 py-3 text-xs text-gray-500 cursor-pointer select-none">
          What it did{% if briefing.stepCount > 0 %} · {{ briefing.stepCount }} {{ 'step' if briefing.stepCount == 1 else 'steps' }}{% endif %}
        </summary>

        <div class="px-4 py-4 space-y-4 bg-gray-50 rounded-b-lg">
          <template x-for="(message, index) in messages" :key="index">
            <div x-show="message.role !== 'assistant' || message.content !== '' || message.reasoning !== ''">
              {% include 'partials/runMessages' %}
            </div>
          </template>
        </div>
      </details>
    {% endif %}
  {% endmacro %}

  <div class="max-w-3xl">
    <div class="mb-6 flex flex-wrap items-start gap-4">
      <div class="flex-1 min-w-0">
        <h1 class="text-2xl font-bold">Briefing</h1>
        <p class="mt-1 text-sm text-gray-500">
          {% if latest %}Last briefed {{ latest.ago }}.{% endif %}
          {% if nextText %}
            Next briefing {{ nextText }}.
          {% else %}
            Scheduled briefings are off; <a href="/settings" class="underline hover:text-gray-800">turn them on in Settings</a>.
          {% endif %}
        </p>
      </div>

      <form method="post" action="/briefing/run">
        <button type="submit" class="flex items-center gap-1.5 px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg disabled:opacity-50 disabled:hover:bg-sky-500"
          {% if isRunning %}disabled{% endif %}>
          {% if isRunning %}
            <span class="icon-loading inline-block size-4 bg-current" aria-hidden="true"></span>
            Briefing…
          {% else %}
            <span class="icon-briefing inline-block size-4 bg-current" aria-hidden="true"></span>
            Brief me now
          {% endif %}
        </button>
      </form>
    </div>

    <div class="space-y-6">
      {% if isRunning %}
        <section x-data="briefingRun" class="bg-white rounded-lg shadow-sm">
          <div class="flex flex-wrap items-center gap-3 px-4 py-3 border-b border-gray-200">
            <span class="icon-loading inline-block size-5 shrink-0 bg-current text-sky-600" aria-hidden="true"></span>

            <div class="flex-1 min-w-48">
              <h2 class="font-bold">Briefing now</h2>
              <p class="mt-0.5 text-xs text-gray-500">Rook is looking over your memories, tasks and recent chats. This page updates when it's done.</p>
            </div>

            <form method="post" action="/briefing/cancel" x-data="{ cancelling: false }" @submit="cancelling = true">
              <button type="submit" class="px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white text-gray-700 hover:bg-gray-50 disabled:opacity-50"
                :disabled="cancelling" x-text="cancelling ? 'Cancelling…' : 'Cancel briefing'">Cancel briefing</button>
            </form>
          </div>

          {# Its replies and tool calls as they come, scrolling within the card #}
          <div x-ref="messages" class="max-h-[60vh] overflow-y-auto px-4 py-4 bg-gray-50 rounded-b-lg">
            <div class="space-y-4">
              <template x-for="(message, index) in messages" :key="index">
                {# A reply that only called a tool, without saying anything, isn't shown; the tool's row is #}
                <div x-show="message.role !== 'assistant' || message.content !== '' || message.reasoning !== ''">
                  {% include 'partials/runMessages' %}
                </div>
              </template>

              {# Waiting on the model: reading what it's given, thinking, or after a tool's result #}
              <div x-cloak x-show="isWaiting()" class="flex justify-start">
                <div class="px-4 py-2.5 rounded-2xl bg-white shadow-sm">
                  <span class="icon-loading block size-5 bg-current text-gray-400" aria-label="Waiting for the model"></span>
                </div>
              </div>
            </div>
          </div>
        </section>
      {% endif %}

      {% if latest %}
        <section class="bg-white rounded-lg shadow-sm">
          <div class="px-4 py-3 border-b border-gray-200">
            <h2 class="font-bold">{{ latest.when }}</h2>
            <p class="mt-0.5 text-xs text-gray-500">{{ 'Scheduled' if latest.startedBy == 'schedule' else 'Asked for' }} · {{ latest.ago }}{% if latest.took %} · took {{ latest.took }}{% endif %}</p>
          </div>

          {{ briefingBody(latest) }}
        </section>
      {% elif not isRunning %}
        <div class="p-6 text-sm text-center text-gray-500 bg-white rounded-lg shadow-sm">
          <p>No briefings yet.</p>
          <p class="mt-1">A briefing has the chat model look over your memories, tasks and recent chats, tidy them, and write you a short update. Discuss opens a chat about it, with the model speaking first.</p>
        </div>
      {% endif %}

      {% if earlier.length > 0 %}
        <section>
          <h2 class="mb-2 text-sm font-bold text-gray-600">Earlier briefings</h2>

          <div class="space-y-2">
            {% for briefing in earlier %}
              <details class="bg-white rounded-lg shadow-sm">
                <summary class="flex flex-wrap items-baseline gap-x-3 gap-y-1 px-4 py-3 cursor-pointer select-none">
                  <span class="text-sm font-semibold">{{ briefing.when }}</span>
                  <span class="text-xs text-gray-500">
                    {{ briefing.ago }}{% if briefing.took %} · took {{ briefing.took }}{% endif %}{% if briefing.status == 'failed' %} · failed{% endif %}
                  </span>
                </summary>

                <div class="border-t border-gray-200">
                  {{ briefingBody(briefing) }}
                </div>
              </details>
            {% endfor %}
          </div>
        </section>
      {% endif %}
    </div>
  </div>
{% endblock body %}
