{% extends 'layouts/default' %}
{% from 'partials/adminBits' import backLink %}

{% set inputClass = 'w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600' %}

{% block body %}
  <div class="p-4 sm:p-8">
    {{ backLink('/admin/users', 'Users') }}
    <h1 class="text-2xl font-bold">New user</h1>
    <p class="mt-1 mb-6 text-sm text-gray-500">They log in with the email and password. They can change the password themselves in Settings.</p>

    <form method="post" action="/admin/users/new" class="max-w-md bg-white rounded-lg shadow-sm">
      <div class="p-4 space-y-4">
        <div>
          <label for="name" class="block text-sm font-medium">Name</label>
          <input id="name" name="name" type="text" value="{{ values.name }}" required autocomplete="off" autofocus class="{{ inputClass }}">
        </div>
        <div>
          <label for="email" class="block text-sm font-medium">Email</label>
          <input id="email" name="email" type="email" value="{{ values.email }}" required autocomplete="off" spellcheck="false" autocapitalize="off" class="{{ inputClass }}">
        </div>
        <div>
          <label for="password" class="block text-sm font-medium">Password</label>
          <input id="password" name="password" type="password" required minlength="{{ passwordMinLength }}" autocomplete="new-password" placeholder="At least {{ passwordMinLength }} characters" class="{{ inputClass }}">
        </div>
        <div>
          <label for="confirm" class="block text-sm font-medium">Password again</label>
          <input id="confirm" name="confirm" type="password" required minlength="{{ passwordMinLength }}" autocomplete="new-password" class="{{ inputClass }}">
        </div>
        <label class="flex items-start gap-2 text-sm">
          <input type="checkbox" name="isAdmin" class="mt-0.5 size-4 shrink-0 accent-sky-600" {% if values.isAdmin %}checked{% endif %}>
          <span><span class="font-medium">Admin</span><span class="block text-xs text-gray-500">Sees the Admin pages and can change them.</span></span>
        </label>
      </div>
      <div class="flex items-center gap-2 px-4 py-3 border-t border-gray-200">
        <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg">Add</button>
        <a href="/admin/users" class="px-3 py-2 text-sm rounded-lg hover:bg-gray-100">Cancel</a>
      </div>
    </form>
  </div>
{% endblock body %}
