{% extends 'layouts/default' %}
{% from 'partials/adminBits' import backLink %}

{% set inputClass = 'w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600' %}

{% block body %}
  <div class="p-4 sm:p-8">
    {{ backLink('/admin/users', 'Users') }}
    <h1 class="text-2xl font-bold">Change password</h1>
    <p class="mt-1 mb-6 text-sm text-gray-500">For {{ user.name }} ({{ user.email }}). A password needs at least {{ passwordMinLength }} characters. Their browsers stay logged in.</p>

    <form method="post" action="/admin/users/{{ user.id }}/password" class="max-w-md bg-white rounded-lg shadow-sm">
      <div class="p-4 space-y-4">
        <div>
          <label for="password" class="block text-sm font-medium">New password</label>
          <input id="password" name="password" type="password" required minlength="{{ passwordMinLength }}" autocomplete="new-password" autofocus class="{{ inputClass }}">
        </div>
        <div>
          <label for="confirm" class="block text-sm font-medium">New password again</label>
          <input id="confirm" name="confirm" type="password" required minlength="{{ passwordMinLength }}" autocomplete="new-password" class="{{ inputClass }}">
        </div>
      </div>
      <div class="flex items-center gap-2 px-4 py-3 border-t border-gray-200">
        <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg">Change password</button>
        <a href="/admin/users" class="px-3 py-2 text-sm rounded-lg hover:bg-gray-100">Cancel</a>
      </div>
    </form>
  </div>
{% endblock body %}
