{% extends 'layouts/default' %}

{% block mainClass %}relative flex overflow-hidden{% endblock %}

{% block head %}
<script src="/static/marked.min.js"></script>
<script src="/static/purify.min.js"></script>
<script>
  // Links in replies open in a new tab, so following one doesn't leave the chat
  DOMPurify.addHook(`afterSanitizeAttributes`, function (node) {
    if (node.tagName === `A`) {
      node.setAttribute(`target`, `_blank`)
      node.setAttribute(`rel`, `noopener noreferrer`)
    }
  })

  document.addEventListener(`alpine:init`, () => {
    // False when no usable chat model is chosen in Settings
    const canSend = {{ 'true' if modelProblem == null else 'false' }}

    // The memory and task tools share one kind of row: what it says while the tool runs and once
    // it's done, and its icon
    const toolRows = {
      save_memory: { pending: `Remembering`, done: `Remembered`, icon: `icon-memories` },
      search_memories: { pending: `Searching memories`, done: `Searched memories`, icon: `icon-memories` },
      update_memory: { pending: `Updating a memory`, done: `Updated a memory`, icon: `icon-memories` },
      delete_memory: { pending: `Forgetting a memory`, done: `Forgot a memory`, icon: `icon-memories` },
      add_task: { pending: `Adding a task`, done: `Added a task`, icon: `icon-tasks` },
      find_tasks: { pending: `Searching tasks`, done: `Searched tasks`, icon: `icon-tasks` },
      update_task: { pending: `Updating a task`, done: `Updated a task`, icon: `icon-tasks` },
      complete_task: { pending: `Completing a task`, done: `Completed a task`, icon: `icon-tasks` },
    }

    // The math tools' rows show their one-line result, so there's nothing to expand
    const resultRows = {
      calculate: { pending: `Calculating`, done: `Calculated`, icon: `icon-calculator` },
      days_between: { pending: `Counting days`, done: `Counted days`, icon: `icon-calendar` },
      add_to_date: { pending: `Working out a date`, done: `Worked out a date`, icon: `icon-calendar` },
      find_weekday: { pending: `Finding the day`, done: `Found the day`, icon: `icon-calendar` },
    }

    // Attached images are shrunk to this on their long side and sent as JPEG, keeping uploads
    // small and what each costs the model low. A message carries up to maxImages (as
    // routes/chat/send.js allows).
    const maxImageSide = 1600
    const jpegQuality = 0.85
    const maxImages = 4

    Alpine.data(`chat`, () => ({
      // Exposed so the Send button's :disabled expression can read it
      canSend,
      chatId: null,
      chats: [],
      messages: [],
      input: ``,
      // Whether the chat model can see images, so they can be attached
      seesImages: false,
      // Images waiting to go with the next message, as JPEG data URLs (see shrinkImage)
      attachments: [],
      // Why an image wasn't attached
      attachError: null,
      sending: false,
      error: null,
      abort: null,
      // Small screens only: the list of chats opens over the conversation
      listOpen: false,
      // The chat whose delete button is waiting for confirmation
      confirmDeleteId: null,

      init () {
        const dataText = document.getElementById(`chat-data`).textContent
        const data = JSON.parse(dataText)

        this.chatId = data.chat?.id ?? null
        this.chats = data.chats
        this.messages = data.messages
        this.seesImages = data.seesImages === true

        this.scrollToBottom()
        this.$refs.input.focus()

        // A reply was still running when the page was opened; pick it up where it's got to
        if (data.running === true) {
          this.resume()
        }

        // Also runs when send() clears the input, so the box shrinks back
        this.$watch(`input`, () => {
          this.$nextTick(() => this.resizeInput())
        })
      },

      get chatTitle () {
        const current = this.chats.find((item) => item.id === this.chatId)

        if (current == null || current.title == null) {
          return `New chat`
        }

        return current.title
      },

      currentPath () {
        return window.location.pathname
      },

      setChatTitle (id, title) {
        const item = this.chats.find((entry) => entry.id === id)

        if (item != null) {
          item.title = title
        }
      },

      // Moves a chat to the top of the list, adding it if it's new
      bumpChat (id) {
        const index = this.chats.findIndex((item) => item.id === id)

        let item = { id, title: null }

        if (index !== -1) {
          item = this.chats[index]
          this.chats.splice(index, 1)
        }

        this.chats.unshift(item)
      },

      // Replies run on the server whether or not the page is open, so Stop asks the server to
      // stop; the reply's stream then ends by itself. Before the chat has an id (the first
      // message hasn't been answered yet) there's only our own request to cancel.
      stop () {
        if (this.chatId != null) {
          fetch(`/chat/${this.chatId}/stop`, { method: `POST` }).catch(() => {})
        } else if (this.abort != null) {
          this.abort.abort()
        }
      },

      // Watches the chat's reply in progress: everything it has sent so far, then live
      async resume () {
        const controller = new AbortController()
        this.abort = controller
        this.sending = true

        try {
          const response = await fetch(`/chat/${this.chatId}/stream`, { signal: controller.signal })
          await this.readStream(response, this.chatId)
        } catch (err) {
          if (err.name !== `AbortError`) {
            this.error = err.message
          }
        } finally {
          this.finishSending(controller)
        }
      },

      finishSending (controller) {
        // A tool still running when the reply ended was stopped
        for (const message of this.messages) {
          if (message.pending === true) {
            message.pending = false
            message.content = `Stopped before it finished.`
          }
        }

        // A newer send may have started; only clear our own state
        if (this.abort === controller) {
          this.abort = null
          this.sending = false
          this.$nextTick(() => this.$refs.input.focus())
        }
      },

      // Shift+Enter sends; plain Enter starts a new line
      onKeydown (event) {
        const isShiftEnter = event.key === `Enter` && event.shiftKey === true && event.isComposing === false

        if (isShiftEnter) {
          event.preventDefault()
          this.send()
        }
      },

      // An image file => a JPEG data URL at most maxImageSide on its long side, the right way up
      // (phones record which way they were held). Throws when the browser can't read it, e.g. an
      // iPhone's HEIC photo outside Safari.
      async shrinkImage (file) {
        const bitmap = await createImageBitmap(file, { imageOrientation: `from-image` })
        const scale = Math.min(1, maxImageSide / Math.max(bitmap.width, bitmap.height))
        const canvas = document.createElement(`canvas`)

        canvas.width = Math.round(bitmap.width * scale)
        canvas.height = Math.round(bitmap.height * scale)

        // JPEG has no transparency, so a transparent PNG goes on white rather than black
        const context = canvas.getContext(`2d`)
        context.fillStyle = `#fff`
        context.fillRect(0, 0, canvas.width, canvas.height)
        context.drawImage(bitmap, 0, 0, canvas.width, canvas.height)
        bitmap.close()

        return canvas.toDataURL(`image/jpeg`, jpegQuality)
      },

      // Adds image files to the next message, up to maxImages; anything else is ignored
      async attachFiles (files) {
        if (this.seesImages === false) {
          return
        }

        this.attachError = null

        const imageFiles = [...files].filter((file) => file.type.startsWith(`image/`))

        for (const file of imageFiles) {
          if (this.attachments.length >= maxImages) {
            this.attachError = `A message can carry up to ${maxImages} images.`
            break
          }

          try {
            this.attachments.push(await this.shrinkImage(file))
          } catch (err) {
            this.attachError = `${file.name} couldn't be read. Try a JPEG or PNG.`
          }
        }
      },

      removeAttachment (index) {
        this.attachments.splice(index, 1)
        this.attachError = null
      },

      // Pasting an image, like a screenshot, attaches it. Text pasted along with it (some apps
      // copy both) still goes in the box.
      onPaste (event) {
        const files = [...(event.clipboardData?.files ?? [])]

        if (this.seesImages === false || files.some((file) => file.type.startsWith(`image/`)) === false) {
          return
        }

        if (event.clipboardData.getData(`text/plain`) === ``) {
          event.preventDefault()
        }

        this.attachFiles(files)
      },

      // Dropping files on the conversation attaches them; dragged text is left alone
      onDragOver (event) {
        if (event.dataTransfer.types.includes(`Files`)) {
          event.preventDefault()
        }
      },

      onDrop (event) {
        if (event.dataTransfer.files.length > 0) {
          event.preventDefault()
          this.attachFiles(event.dataTransfer.files)
        }
      },

      // A user message's images: as saved, or the data URLs it was sent with until the page reloads
      userImages (message) {
        if (message.imageUrls != null) {
          return message.imageUrls
        }

        return (message.imageIds ?? []).map((id) => `/images/${id}`)
      },

      // Grows the message box to fit its text, up to its max height (then it scrolls)
      resizeInput () {
        const el = this.$refs.input
        const borders = el.offsetHeight - el.clientHeight

        el.style.height = `auto`
        el.style.height = `${el.scrollHeight + borders}px`
      },

      isNearBottom () {
        const el = this.$refs.messages
        const distanceFromBottom = el.scrollHeight - el.scrollTop - el.clientHeight
        return distanceFromBottom < 80
      },

      // A reply's Markdown => HTML that's safe to put in the page. Replies can repeat what the
      // model read on web pages, so anything like a script or a javascript: link is removed.
      // Single line breaks are kept, as the model means them.
      renderMarkdown (text) {
        const html = marked.parse(text, { gfm: true, breaks: true })
        return DOMPurify.sanitize(html)
      },

      scrollToBottom () {
        this.$nextTick(() => {
          const el = this.$refs.messages
          el.scrollTop = el.scrollHeight
        })
      },

      hasToolRow (message) {
        return message.role === `tool` && toolRows[message.name] != null
      },

      // "Remembered" or "Remembering", and so on, for a memory or task tool's row
      toolRowLabel (message) {
        const row = toolRows[message.name]
        return message.pending ? row.pending : row.done
      },

      toolRowIcon (message) {
        return message.pending ? `icon-loading` : toolRows[message.name].icon
      },

      // What the row shows after its label: the memory's text, the task's title or the query
      toolRowText (message) {
        return message.memory ?? message.taskTitle ?? message.query
      },

      hasResultRow (message) {
        return message.role === `tool` && resultRows[message.name] != null
      },

      resultRowLabel (message) {
        const row = resultRows[message.name]
        return message.pending ? row.pending : row.done
      },

      resultRowIcon (message) {
        return message.pending ? `icon-loading` : resultRows[message.name].icon
      },

      lastMessage () {
        // Read through this.messages to get Alpine's reactive copy, so streamed text shows up as it arrives
        return this.messages[this.messages.length - 1]
      },

      // True while waiting for the model with nothing new on screen yet (a tool shows its own progress)
      isWaiting () {
        if (this.sending === false) {
          return false
        }

        const last = this.lastMessage()

        if (last == null || last.role === `user`) {
          return true
        }

        if (last.role === `assistant`) {
          return last.content === ``
        }

        return false
      },

      async send () {
        const text = this.input.trim()
        const images = [...this.attachments]

        if ((text === `` && images.length === 0) || this.sending === true || canSend === false) {
          return
        }

        this.error = null
        this.input = ``
        this.attachments = []
        this.attachError = null
        this.messages.push({ role: `user`, content: text, reasoning: ``, imageUrls: images })

        const controller = new AbortController()
        this.abort = controller
        this.sending = true
        this.scrollToBottom()

        try {
          const response = await fetch(`/chat/send`, {
            method: `POST`,
            headers: { 'Content-Type': `application/json` },
            body: JSON.stringify({ chatId: this.chatId, content: text, images }),
            signal: controller.signal,
          })

          if (response.ok === false) {
            const errorText = await response.text()

            // Nothing was saved, so take the message back out and put it in the box to retry
            this.messages.splice(-1, 1)
            this.input = text
            this.attachments = images

            throw new Error(errorText || `Request failed (${response.status})`)
          }

          const chatId = response.headers.get(`X-Chat-Id`)

          // The first message of a new chat creates it; give it its own URL
          if (this.chatId == null) {
            this.chatId = chatId
            history.replaceState(null, ``, `/chat/${chatId}`)
          }

          this.bumpChat(chatId)

          await this.readStream(response, chatId)
        } catch (err) {
          if (err.name !== `AbortError`) {
            this.error = err.message
          }
        } finally {
          this.finishSending(controller)
        }
      },

      // The reply is a stream of rook's own events, one JSON object per "data:" line
      // (see runConversation in routes/chat/send.js)
      async readStream (response, chatId) {
        const reader = response.body.getReader()
        const decoder = new TextDecoder()
        let buffer = ``

        while (true) {
          const { value, done } = await reader.read()

          if (done) {
            break
          }

          buffer += decoder.decode(value, { stream: true })

          const lines = buffer.split(`\n`)
          // The last piece may be half a line; keep it for the next chunk
          buffer = lines.pop()

          const shouldScroll = this.isNearBottom()

          for (const line of lines) {
            this.readEvent(line, chatId)
          }

          if (shouldScroll) {
            this.scrollToBottom()
          }
        }
      },

      readEvent (line, chatId) {
        const trimmed = line.trim()

        if (trimmed.startsWith(`data:`) === false) {
          return
        }

        const event = JSON.parse(trimmed.slice(5))
        const last = this.lastMessage()

        if (event.type === `assistant`) {
          this.messages.push({ role: `assistant`, content: ``, reasoning: `` })
        } else if (event.type === `reasoning` && last?.role === `assistant`) {
          last.reasoning += event.text
        } else if (event.type === `content` && last?.role === `assistant`) {
          last.content += event.text
        } else if (event.type === `toolCall`) {
          this.messages.push({
            role: `tool`,
            toolCallId: event.toolCallId,
            name: event.name,
            prompt: event.prompt,
            url: event.url,
            query: event.query,
            memory: event.memory,
            taskTitle: event.taskTitle,
            imageId: null,
            content: ``,
            pending: true,
          })
        } else if (event.type === `toolResult`) {
          const toolMessage = this.messages.find((message) => message.toolCallId === event.toolCallId)

          if (toolMessage != null) {
            toolMessage.pending = false
            toolMessage.imageId = event.imageId
            toolMessage.content = event.content
          }
        } else if (event.type === `title`) {
          this.setChatTitle(chatId, event.title)
        } else if (event.type === `error`) {
          this.error = event.message
        } else if (event.type === `finished`) {
          // The reply ended between the page loading and watching it; show what was saved
          window.location.reload()
        }
      },
    }))
  })
</script>
{% endblock %}

{% block body %}
<script type="application/json" id="chat-data">{{ pageJSON | safe }}</script>

<div x-data="chat" class="flex flex-1 min-w-0">
  {# Backdrop behind the chat list on small screens #}
  <div x-cloak x-show="listOpen" class="absolute inset-0 z-10 bg-black/30 md:hidden" @click="listOpen = false"></div>

  <aside class="absolute inset-y-0 left-0 z-20 w-64 hidden md:static md:flex flex-col shrink-0 bg-white border-r border-gray-200"
    :class="{ 'hidden': !listOpen, 'flex': listOpen }" aria-label="Chats">
    <div class="shrink-0 p-3 border-b border-gray-200">
      <a href="/chat" class="flex items-center justify-center gap-1.5 px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50">
        <span class="icon-plus inline-block size-4 bg-current" aria-hidden="true"></span>
        New chat
      </a>
    </div>

    <nav class="flex-1 overflow-y-auto p-2 space-y-0.5">
      <p x-show="chats.length === 0" class="px-3 py-2 text-xs text-gray-500">No saved chats yet.</p>

      <template x-for="item in chats" :key="item.id">
        <div class="group relative">
          <a :href="`/chat/${item.id}`"
            class="block py-2 pl-3 pr-9 text-sm rounded-md truncate"
            :class="item.id === chatId ? 'bg-sky-50 text-sky-700 font-semibold' : 'text-gray-700 hover:bg-gray-100'"
            :aria-current="item.id === chatId ? 'page' : null"
            :title="item.title ?? 'New chat'">
            <span x-text="item.title ?? 'New chat'" :class="{ 'italic text-gray-400': item.title == null }"></span>
          </a>

          <button type="button" x-show="confirmDeleteId !== item.id"
            class="absolute right-1 top-1/2 -translate-y-1/2 p-1.5 rounded text-gray-400 hover:text-red-600 hover:bg-red-50 md:opacity-0 md:group-hover:opacity-100 focus:opacity-100"
            aria-label="Delete chat" @click="confirmDeleteId = item.id">
            <span class="icon-delete block size-4 bg-current" aria-hidden="true"></span>
          </button>

          <form x-cloak x-show="confirmDeleteId === item.id" method="post" :action="`/chat/${item.id}/delete`"
            class="flex items-center gap-2 px-3 py-1.5 text-xs" @keydown.escape="confirmDeleteId = null">
            <input type="hidden" name="returnTo" :value="currentPath()">
            <span class="flex-1 text-gray-600">Delete this chat?</span>
            <button type="submit" class="px-2 py-1 font-bold text-white bg-red-600 hover:bg-red-700 rounded">Delete</button>
            <button type="button" class="px-2 py-1 rounded hover:bg-gray-100" @click="confirmDeleteId = null">Cancel</button>
          </form>
        </div>
      </template>
    </nav>
  </aside>

  {# Image files dropped anywhere on the conversation are attached to the next message #}
  <div class="flex flex-col flex-1 min-w-0" @dragover="onDragOver($event)" @drop="onDrop($event)">
    <div class="shrink-0 flex flex-wrap items-center gap-3 px-4 py-3 bg-white border-b border-gray-200">
      <button type="button" class="md:hidden -ml-1 p-1.5 rounded-md text-gray-600 hover:bg-gray-100" aria-label="Show chats" @click="listOpen = true">
        <span class="icon-chats block size-5 bg-current" aria-hidden="true"></span>
      </button>

      <h1 class="min-w-0 flex-1 text-lg font-bold truncate" x-text="chatTitle">{{ chat.title if chat and chat.title else 'New chat' }}</h1>

      <button type="button" class="-mr-1 p-1.5 rounded-md text-gray-600 hover:bg-gray-100" aria-label="Chat settings" title="Current settings"
        @click="$refs.configDialog.showModal()">
        <span class="icon-info block size-5 bg-current" aria-hidden="true"></span>
      </button>
    </div>

    {# What Settings give every chat right now. A click on the backdrop lands on the dialog itself, so it closes. #}
    <dialog x-ref="configDialog" class="m-auto w-[calc(100%-2rem)] max-w-md p-0 rounded-lg shadow-xl backdrop:bg-black/30" aria-labelledby="config-dialog-title"
      @click.self="$el.close()">
      <div class="p-5">
        <h2 id="config-dialog-title" class="text-base font-bold">Current settings</h2>

        <dl class="mt-4 space-y-3 text-sm">
          <div>
            <dt class="text-xs text-gray-500">Chat model</dt>
            <dd class="break-words">{{ chatModel if chatModel else 'None chosen' }}</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">Images</dt>
            <dd class="break-words">
              {% if imageModel %}{{ imageModel }} · {{ imageSize | replace('x', '×') }}{% else %}Off{% endif %}
            </dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">Web pages</dt>
            <dd>
              {% if webDomains.length > 0 %}
                <ul class="max-h-48 overflow-y-auto">
                  {% for domain in webDomains %}
                    <li class="break-words">{{ domain }}</li>
                  {% endfor %}
                </ul>
              {% else %}
                Off
              {% endif %}
            </dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">Web search</dt>
            <dd>{{ 'On' if webSearchOn else 'Off' }}</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">Memories</dt>
            <dd class="break-words">{{ memoriesSummary if memoriesSummary else 'Off' }}</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">Tasks</dt>
            <dd>{{ 'On' if tasksOn else 'Off' }}</dd>
          </div>
        </dl>

        <form method="dialog" class="mt-5 flex flex-wrap items-center gap-3">
          <p class="flex-1 text-xs text-gray-500">These apply to every chat.</p>
          <a href="/settings" class="px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50">Change in Settings</a>
          <button type="submit" class="px-3 py-1.5 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-md">Close</button>
        </form>
      </div>
    </dialog>

    <div x-ref="messages" class="flex-1 min-h-0 overflow-y-auto px-4 py-6">
      <div class="mx-auto max-w-3xl space-y-4">
        {% if modelProblem %}
          <div class="flex flex-wrap items-center gap-3 p-4 text-sm rounded-lg border border-amber-200 bg-amber-50 text-amber-900" role="alert">
            <span class="flex-1">{{ modelProblem.message }}</span>
            {% if modelProblem.link %}
              <a href="{{ modelProblem.link.href }}" class="px-3 py-1.5 font-bold rounded-md bg-white border border-amber-300 hover:bg-amber-100">{{ modelProblem.link.label }}</a>
            {% endif %}
          </div>
        {% endif %}

        <p x-show="messages.length === 0" class="pt-16 text-sm text-center text-gray-500">Send a message to start a conversation.</p>

        <template x-for="(message, index) in messages" :key="index">
          {# A reply that only called a tool, without saying anything, isn't shown; the tool's result is #}
          <div x-show="message.role !== 'assistant' || message.content !== '' || message.reasoning !== ''">
            {# The images the user attached go above their text. Once saved, each opens full size;
               before that it's a data URL, which browsers won't open in a tab. #}
            <template x-if="message.role === 'user'">
              <div class="flex flex-col items-end gap-1.5">
                <div x-show="userImages(message).length > 0" class="max-w-[85%] flex flex-wrap justify-end gap-1.5">
                  <template x-for="(src, imageIndex) in userImages(message)" :key="imageIndex">
                    <a :href="src.startsWith('/images/') ? src : null" target="_blank" title="Open full size">
                      <img :src="src" alt="Attached image" class="h-32 max-w-full rounded-xl border border-gray-200 object-cover">
                    </a>
                  </template>
                </div>
                <div x-show="message.content !== ''" class="max-w-[85%] px-4 py-2.5 text-sm rounded-2xl bg-sky-600 text-white whitespace-pre-wrap break-words" x-text="message.content"></div>
              </div>
            </template>

            <template x-if="message.role === 'assistant'">
              <div class="flex justify-start">
                <div class="max-w-[85%] px-4 py-2.5 text-sm rounded-2xl bg-white text-gray-900 shadow-sm">
                  <details x-show="message.reasoning !== ''" class="text-xs text-gray-500" :class="{ 'mb-2': message.content !== '' }">
                    <summary class="cursor-pointer select-none">Thinking</summary>
                    <div class="mt-1 whitespace-pre-wrap break-words" x-text="message.reasoning"></div>
                  </details>

                  <div x-show="message.content !== ''" class="markdown break-words" x-html="renderMarkdown(message.content)"></div>
                </div>
              </div>
            </template>

            {# An image tool's result: the image it made, its progress, or what went wrong #}
            <template x-if="message.role === 'tool' && message.name === 'generate_image'">
              <div class="flex justify-start">
                <figure class="w-80 sm:w-96 max-w-[85%] p-2 bg-white rounded-2xl shadow-sm">
                  <div x-show="message.pending" class="flex aspect-square items-center justify-center gap-2 rounded-xl bg-gray-100 text-sm text-gray-500">
                    <span class="icon-loading inline-block size-5 bg-current" aria-hidden="true"></span>
                    Creating image…
                  </div>

                  <template x-if="message.imageId">
                    <a :href="`/images/${message.imageId}`" target="_blank" title="Open full size">
                      <img :src="`/images/${message.imageId}`" :alt="message.prompt ?? 'Generated image'" class="w-full rounded-xl"
                        @load="if (index === messages.length - 1 || index === messages.length - 2) scrollToBottom()">
                    </a>
                  </template>

                  <p x-show="!message.pending && !message.imageId" class="px-2 py-1 text-sm text-gray-600" x-text="message.content"></p>

                  <figcaption x-show="message.prompt" class="px-2 pt-2 pb-1 text-xs text-gray-500" x-text="message.prompt"></figcaption>
                </figure>
              </div>
            </template>

            {# A web page the model read: a link to it, and what it read when expanded #}
            <template x-if="message.role === 'tool' && message.name === 'read_web_page'">
              <div class="flex justify-start">
                <details class="max-w-[85%] min-w-0 px-4 py-2.5 text-xs text-gray-500 bg-white rounded-2xl shadow-sm">
                  <summary class="flex items-center gap-2 cursor-pointer select-none">
                    <span class="inline-block size-4 shrink-0 bg-current" :class="message.pending ? 'icon-loading' : 'icon-web'" aria-hidden="true"></span>
                    <span x-text="message.pending ? 'Reading' : 'Read'"></span>
                    <a x-show="message.url" :href="message.url" target="_blank" rel="noopener" class="min-w-0 truncate underline hover:text-gray-800"
                      x-text="message.url?.replace(/^https?:\/\//, '')" @click.stop></a>
                  </summary>
                  <div x-show="!message.pending" class="mt-2 max-h-80 overflow-y-auto whitespace-pre-wrap break-words text-gray-700" x-text="message.content"></div>
                </details>
              </div>
            </template>

            {# A web search: its query, and the results the model got when expanded (with working links) #}
            <template x-if="message.role === 'tool' && message.name === 'web_search'">
              <div class="flex justify-start">
                <details class="max-w-[85%] min-w-0 px-4 py-2.5 text-xs text-gray-500 bg-white rounded-2xl shadow-sm">
                  <summary class="flex items-center gap-2 cursor-pointer select-none">
                    <span class="inline-block size-4 shrink-0 bg-current" :class="message.pending ? 'icon-loading' : 'icon-search'" aria-hidden="true"></span>
                    <span x-text="message.pending ? 'Searching' : 'Searched'"></span>
                    <span x-show="message.query" class="min-w-0 truncate text-gray-700" x-text="message.query"></span>
                  </summary>
                  <div x-show="!message.pending" class="markdown mt-2 max-h-80 overflow-y-auto break-words text-gray-700" x-html="renderMarkdown(message.content)"></div>
                </details>
              </div>
            </template>

            {# The model checked the date and time, or converted a time between zones: what it
               was told, when expanded #}
            <template x-if="message.role === 'tool' && (message.name === 'get_current_time' || message.name === 'convert_time')">
              <div class="flex justify-start">
                <details class="max-w-[85%] min-w-0 px-4 py-2.5 text-xs text-gray-500 bg-white rounded-2xl shadow-sm">
                  <summary class="flex items-center gap-2 cursor-pointer select-none">
                    <span class="inline-block size-4 shrink-0 bg-current" :class="message.pending ? 'icon-loading' : 'icon-clock'" aria-hidden="true"></span>
                    <span x-show="message.name === 'get_current_time'" x-text="message.pending ? 'Checking the time' : 'Checked the time'"></span>
                    <span x-show="message.name === 'convert_time'" x-text="message.pending ? 'Converting the time' : 'Converted the time'"></span>
                  </summary>
                  <div x-show="!message.pending" class="mt-2 whitespace-pre-wrap break-words text-gray-700" x-text="message.content"></div>
                </details>
              </div>
            </template>

            {# A sum or date the model worked out, with the answer it got #}
            <template x-if="hasResultRow(message)">
              <div class="flex justify-start">
                <div class="max-w-[85%] min-w-0 flex items-start gap-2 px-4 py-2.5 text-xs text-gray-500 bg-white rounded-2xl shadow-sm">
                  <span class="inline-block size-4 shrink-0 bg-current" :class="resultRowIcon(message)" aria-hidden="true"></span>
                  <span class="shrink-0" x-text="resultRowLabel(message)"></span>
                  <span x-show="!message.pending" class="min-w-0 break-words text-gray-700" x-text="message.content"></span>
                </div>
              </div>
            </template>

            {# A memory or task saved, searched for, changed or completed: its text, title or query, and the result when expanded #}
            <template x-if="hasToolRow(message)">
              <div class="flex justify-start">
                <details class="max-w-[85%] min-w-0 px-4 py-2.5 text-xs text-gray-500 bg-white rounded-2xl shadow-sm">
                  <summary class="flex items-center gap-2 cursor-pointer select-none">
                    <span class="inline-block size-4 shrink-0 bg-current" :class="toolRowIcon(message)" aria-hidden="true"></span>
                    <span class="shrink-0" x-text="toolRowLabel(message)"></span>
                    <span x-show="toolRowText(message)" class="min-w-0 truncate text-gray-700" x-text="toolRowText(message)"></span>
                  </summary>
                  <div x-show="!message.pending" class="mt-2 max-h-80 overflow-y-auto whitespace-pre-wrap break-words text-gray-700" x-text="message.content"></div>
                </details>
              </div>
            </template>
          </div>
        </template>

        {# Waiting for the model to start (it may be loading, or thinking about a tool's result) #}
        <div x-cloak x-show="isWaiting()" class="flex justify-start">
          <div class="px-4 py-2.5 rounded-2xl bg-white shadow-sm">
            <span class="icon-loading block size-5 bg-current text-gray-400" aria-label="Waiting for reply"></span>
          </div>
        </div>

        <div x-cloak x-show="error" class="p-4 text-sm rounded-lg border border-red-200 bg-red-50 text-red-800" role="alert" x-text="error"></div>
      </div>
    </div>

    <form class="shrink-0 px-4 py-3 bg-white border-t border-gray-200" @submit.prevent="send()">
      <div class="mx-auto max-w-3xl">
        {# The images going with the next message, each with a button to take it off #}
        <div x-cloak x-show="attachments.length > 0 || attachError" class="mb-2 flex flex-wrap items-center gap-2">
          <template x-for="(src, index) in attachments" :key="index">
            <div class="relative">
              <img :src="src" alt="Image to send" class="size-16 rounded-lg border border-gray-200 object-cover">
              <button type="button" @click="removeAttachment(index)" aria-label="Remove image"
                class="absolute -top-1.5 -right-1.5 flex size-5 items-center justify-center rounded-full bg-gray-700 text-white hover:bg-gray-900">
                <span class="icon-close inline-block size-3 bg-current" aria-hidden="true"></span>
              </button>
            </div>
          </template>
          <p x-show="attachError" class="text-xs text-red-700" role="alert" x-text="attachError"></p>
        </div>

        <div class="flex items-end gap-2">
          {# Only while the chat model can see images. On phones it offers the camera too. #}
          <input type="file" x-ref="fileInput" accept="image/*" multiple class="hidden"
            @change="attachFiles($event.target.files); $event.target.value = ''">
          <button type="button" x-cloak x-show="seesImages" @click="$refs.fileInput.click()" :disabled="canSend === false"
            class="p-2 rounded-lg text-gray-500 hover:text-gray-800 hover:bg-gray-100 disabled:opacity-50" aria-label="Attach images" title="Attach images">
            <span class="icon-image-plus block size-5 bg-current" aria-hidden="true"></span>
          </button>

          <label class="sr-only" for="chat-input">Message</label>
          <textarea id="chat-input" x-ref="input" x-model="input" @keydown="onKeydown($event)" @paste="onPaste($event)" rows="2"
            placeholder="Message {{ config.appName }}… (Shift+Enter to send)"
            class="flex-1 max-h-60 resize-none p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600"
            {% if modelProblem %}disabled{% endif %}></textarea>

          <button type="submit" x-show="!sending" :disabled="(input.trim() === '' && attachments.length === 0) || canSend === false"
            class="flex items-center gap-1.5 px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg disabled:opacity-50 disabled:hover:bg-sky-500">
            <span class="icon-send inline-block size-4 bg-current" aria-hidden="true"></span>
            Send
          </button>
          <button type="button" x-cloak x-show="sending" @click="stop()"
            class="flex items-center gap-1.5 px-4 py-2 text-sm font-bold text-white bg-gray-700 hover:bg-gray-800 rounded-lg">
            <span class="icon-stop inline-block size-4 bg-current" aria-hidden="true"></span>
            Stop
          </button>
        </div>
      </div>
    </form>
  </div>
</div>
{% endblock body %}
