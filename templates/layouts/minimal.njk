<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>
      {% block title %}{{ config.appName }}{% endblock %}
    </title>
    <meta data-n-head="ssr" name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, minimal-ui">

    <meta name="theme-color" content="#ffffff">
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg?v=2">
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png?v=2">
    <link rel="manifest" href="/static/manifest.json">
    {# Installed as a web app (Add to Home Screen, Add to Dock, Install), it opens without browser chrome #}
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ config.appName }}">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <link rel="stylesheet" href="/dist/application.css">
    <script defer src="/static/alpine.min.js"></script>

    <style>
      [x-cloak] { display: none !important; }
    </style>

    <script>
      // If this page loads inside one of our tabs (e.g. the session expired), take over the whole window
      try {
        if (window.top !== window.self && window.top.location.origin === window.location.origin) {
          window.top.location.href = window.location.href
        }
      } catch (err) {}
    </script>

    {% block head %}
    {% endblock %}
  </head>

  <body class="bg-gray-100 text-gray-900">
    <main class="mx-auto max-w-screen-sm px-4 py-12 sm:py-20">
      {# The rook from static/favicon.svg, drawn inline in the text colour so it stays dark on this
         light page whatever the system theme #}
      <div class="mb-8 flex flex-col items-center gap-3">
        <svg class="size-20 fill-current" viewBox="0 0 64 64" aria-hidden="true">
          <path d="M14 6H22V12H28V6H36V12H42V6H50V19L45 24V44L50 49V52H54V58H10V52H14V49L19 44V24L14 19Z"/>
        </svg>
        <div class="text-4xl font-bold tracking-tight">Rook</div>
      </div>
      {# Messages stay inline here, next to the small centered form, rather than as toasts #}
      {% for flash in ctx.getFlash() %}
        {% set colors = 'border-sky-200 bg-sky-50 text-sky-800' %}
        {% set role = 'status' %}
        {% if flash[1] == 'error' %}
          {% set colors = 'border-red-200 bg-red-50 text-red-800' %}
          {% set role = 'alert' %}
        {% elif flash[1] == 'success' %}
          {% set colors = 'border-green-200 bg-green-50 text-green-800' %}
        {% endif %}
        <div class="mb-4 p-4 text-sm rounded-lg border {{ colors }}" role="{{ role }}">{{ flash[0] }}</div>
      {% endfor %}
      {% block body %}
      {% endblock %}
    </main>
  </body>
</html>
