{% set nav = [
  { href: '/briefing', label: 'Briefing', icon: 'icon-briefing' },
  { href: '/chat', label: 'Chat', icon: 'icon-chat' },
  { href: '/tasks', label: 'Tasks', icon: 'icon-tasks' },
  { href: '/memories', label: 'Memories', icon: 'icon-memories' },
  { href: '/notifications', label: 'Notifications', icon: 'icon-bell' },
  { href: '/settings', label: 'Settings', icon: 'icon-settings' }
] -%}
{# The Admin pages are admins' alone (see middleware/auth.js). They sit in a group that opens and
   closes; it's drawn open on the admin pages themselves. #}
{% set onAdminPage = ctx.path == '/admin' or ctx.path.startsWith('/admin/') %}
{% if ctx.state.user and ctx.state.user.isAdmin %}
  {% set nav = nav.concat([{ label: 'Admin', icon: 'icon-admin', key: 'admin', children: [
    { href: '/admin', label: 'Overview', icon: 'icon-overview', exact: true },
    { href: '/admin/users', label: 'Users', icon: 'icon-users' },
    { href: '/admin/lemonade', label: 'Lemonade', icon: 'icon-server' },
    { href: '/admin/models', label: 'Models', icon: 'icon-models' },
    { href: '/admin/tools', label: 'Tools', icon: 'icon-tools' },
    { href: '/admin/briefings', label: 'Briefings', icon: 'icon-schedule' }
  ] }]) -%}
{% endif -%}
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <title>
      {% block title %}{{ config.appName }}{% endblock %}
    </title>
    <meta data-n-head="ssr" name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, minimal-ui">

    <meta name="theme-color" content="#ffffff">
    <link rel="icon" type="image/svg+xml" href="/static/favicon.svg?v=2">
    <link rel="apple-touch-icon" href="/static/apple-touch-icon.png?v=2">
    <link rel="manifest" href="/static/manifest.json">
    {# Installed as a web app (Add to Home Screen, Add to Dock, Install), it opens without browser chrome #}
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ config.appName }}">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">

    <link rel="stylesheet" href="/dist/application.css">
    <script defer src="/static/alpine.min.js"></script>

    <style>
      [x-cloak] { display: none !important; }
    </style>

    <script>
      // Runs before the first paint, so a sidebar the user closed doesn't flash open on every page load
      try {
        if (localStorage.getItem(`rook.sidebar`) === `closed`) {
          document.documentElement.dataset.sidebar = `closed`
        }
      } catch (err) {}

      document.addEventListener(`alpine:init`, () => {
        // `indicators` is what the server rendered the nav dots and the tasks badge with:
        // { briefingIsNew, notificationsUnseen, tasksBadge }
        Alpine.data(`layout`, (indicators, navOpen) => ({
          ...indicators,

          // Small screens only: the sidebar slides over the page and starts closed
          mobileOpen: false,

          // Which nav groups are open, by their key. On a group's own pages the server renders it
          // open and that stays; elsewhere the last choice made in this browser is used.
          navOpen,

          // A page can stay open a long time (a chat does), so the indicators are asked for again
          // every so often, and as soon as the tab is looked at again
          init () {
            for (const key of Object.keys(this.navOpen)) {
              if (this.navOpen[key] === false) {
                try {
                  this.navOpen[key] = localStorage.getItem(`rook.nav.${key}`) === `open`
                } catch (err) {}
              }
            }

            setInterval(() => this.refresh(), 30000)

            document.addEventListener(`visibilitychange`, () => this.refresh())

            // Back to a page from the browser's cache, which still shows what it had before
            window.addEventListener(`pageshow`, (event) => {
              if (event.persisted) {
                this.refresh()
              }
            })
          },

          async refresh () {
            if (document.hidden) {
              return
            }

            try {
              const response = await fetch(`/indicators`)
              const body = await response.json()

              // The Briefing and Notifications pages mark what they show as seen, so on those a
              // reload shows the new one and clears its dot
              const path = window.location.pathname
              const isNewHere = (path === `/briefing` && body.briefingIsNew) ||
                (path === `/notifications` && body.notificationsUnseen)

              if (isNewHere) {
                window.location.reload()
                return
              }

              this.briefingIsNew = body.briefingIsNew
              this.notificationsUnseen = body.notificationsUnseen
              this.tasksBadge = body.tasksBadge
            } catch (err) {}
          },

          toggleGroup (key) {
            this.navOpen[key] = !this.navOpen[key]

            try {
              localStorage.setItem(`rook.nav.${key}`, this.navOpen[key] ? `open` : `closed`)
            } catch (err) {}
          },

          toggleSidebar () {
            const isWide = window.matchMedia(`(min-width: 64rem)`).matches

            if (isWide === false) {
              this.mobileOpen = !this.mobileOpen
              return
            }

            const root = document.documentElement
            const isClosed = root.dataset.sidebar === `closed`

            if (isClosed) {
              delete root.dataset.sidebar
            } else {
              root.dataset.sidebar = `closed`
            }

            try {
              localStorage.setItem(`rook.sidebar`, isClosed ? `open` : `closed`)
            } catch (err) {}
          },
        }))
      })
    </script>

    {% block head %}
    {% endblock %}
  </head>

  <body class="h-dvh flex flex-col bg-gray-100 text-gray-900"
    x-data="layout({ briefingIsNew: {{ briefingIsNew }}, notificationsUnseen: {{ notificationsUnseen }}, tasksBadge: {{ tasksBadge }} }, { admin: {{ 'true' if onAdminPage else 'false' }} })">
    <header class="h-14 shrink-0 flex items-center gap-3 px-4 bg-white border-b border-gray-200">
      <button type="button" class="-ml-1 p-1.5 rounded-md text-gray-600 hover:bg-gray-100" aria-label="Toggle navigation" @click="toggleSidebar()">
        <span class="icon-menu block size-5 bg-current" aria-hidden="true"></span>
      </button>
      <a href="/" class="text-lg font-bold">{{ config.appName }}</a>
    </header>

    <div class="relative flex-1 min-h-0 flex">
      {# Backdrop behind the sidebar on small screens #}
      <div x-cloak x-show="mobileOpen" class="fixed inset-0 top-14 z-10 bg-black/30 lg:hidden" @click="mobileOpen = false"></div>

      <aside id="sidebar"
        class="fixed top-14 bottom-0 left-0 z-20 w-56 shrink-0 flex flex-col bg-white border-r border-gray-200 transition-transform -translate-x-full lg:static lg:translate-x-0 lg:transition-none"
        :class="{ '-translate-x-full': !mobileOpen }">
        <nav class="flex-1 overflow-y-auto p-3 space-y-1">
          {% for item in nav %}
            {% if item.children %}
              {# A group: a row that opens and closes its pages, drawn open when one of them is shown #}
              {% set isOpen = onAdminPage %}
              <button type="button" class="w-full flex items-center gap-2 px-3 py-2 text-sm rounded-md text-gray-700 hover:bg-gray-100"
                :aria-expanded="navOpen.{{ item.key }}" aria-expanded="{{ 'true' if isOpen else 'false' }}" @click="toggleGroup('{{ item.key }}')">
                <span class="{{ item.icon }} inline-block size-4 shrink-0 bg-current" aria-hidden="true"></span>
                <span class="flex-1 text-left">{{ item.label }}</span>
                <span class="icon-chevron inline-block size-4 shrink-0 bg-current text-gray-400 transition-transform {% if isOpen %}rotate-180{% endif %}" :class="{ 'rotate-180': navOpen.{{ item.key }} }" aria-hidden="true"></span>
              </button>
              <div class="space-y-1" x-show="navOpen.{{ item.key }}" {% if not isOpen %}x-cloak{% endif %}>
                {% for child in item.children %}
                  {% set isCurrent = ctx.path == child.href or (not child.exact and ctx.path.startsWith(child.href + '/')) %}
                  <a href="{{ child.href }}"
                    class="flex items-center gap-2 pl-8 pr-3 py-1.5 text-sm rounded-md {% if isCurrent %}bg-sky-50 text-sky-700 font-semibold{% else %}text-gray-700 hover:bg-gray-100{% endif %}"
                    {% if isCurrent %}aria-current="page"{% endif %}>
                    <span class="{{ child.icon }} inline-block size-4 shrink-0 bg-current" aria-hidden="true"></span>
                    <span class="flex-1">{{ child.label }}</span>
                  </a>
                {% endfor %}
              </div>
            {% else %}
            {% set isCurrent = ctx.path == item.href or ctx.path.startsWith(item.href + '/') %}
            <a href="{{ item.href }}"
              class="flex items-center gap-2 px-3 py-2 text-sm rounded-md {% if isCurrent %}bg-sky-50 text-sky-700 font-semibold{% else %}text-gray-700 hover:bg-gray-100{% endif %}"
              {% if isCurrent %}aria-current="page"{% endif %}>
              <span class="{{ item.icon }} inline-block size-4 shrink-0 bg-current" aria-hidden="true"></span>
              <span class="flex-1">{{ item.label }}</span>
              {# A briefing has finished since the Briefing page was last opened. Rendered as they
                 start, so nothing flashes before Alpine takes over. #}
              {% if item.href == '/briefing' %}
                <span x-show="briefingIsNew" class="size-2 rounded-full bg-sky-500" aria-hidden="true"
                  {% if not briefingIsNew %}style="display: none"{% endif %}></span>
                <span x-show="briefingIsNew" class="sr-only" {% if not briefingIsNew %}style="display: none"{% endif %}>New briefing</span>
              {% endif %}
              {# A notification has arrived since the Notifications page was last opened #}
              {% if item.href == '/notifications' %}
                <span x-show="notificationsUnseen" class="size-2 rounded-full bg-sky-500" aria-hidden="true"
                  {% if not notificationsUnseen %}style="display: none"{% endif %}></span>
                <span x-show="notificationsUnseen" class="sr-only" {% if not notificationsUnseen %}style="display: none"{% endif %}>New notifications</span>
              {% endif %}
              {# Tasks due today or overdue #}
              {% if item.href == '/tasks' %}
                <span x-show="tasksBadge > 0" x-text="tasksBadge" :aria-label="`${tasksBadge} due today or overdue`"
                  class="min-w-5 px-1.5 text-center text-xs font-bold leading-5 rounded-full bg-red-500 text-white"
                  aria-label="{{ tasksBadge }} due today or overdue" {% if tasksBadge == 0 %}style="display: none"{% endif %}>{{ tasksBadge }}</span>
              {% endif %}
            </a>
            {% endif %}
          {% endfor %}
        </nav>

        <div class="p-3 border-t border-gray-200">
          <div class="px-3 pb-2 text-xs text-gray-500 truncate">{{ ctx.state.user.name }}</div>
          <a href="/auth/logout" class="flex items-center gap-2 px-3 py-2 text-sm rounded-md text-gray-700 hover:bg-gray-100">
            <span class="icon-logout inline-block size-4 shrink-0 bg-current" aria-hidden="true"></span>
            Log out
          </a>
        </div>
      </aside>

      <main class="flex-1 min-w-0 {% block mainClass %}overflow-y-auto p-4 sm:p-8{% endblock %}">
        {% include 'partials/flash' %}
        {% block body %}
        {% endblock %}
      </main>
    </div>
  </body>
</html>
