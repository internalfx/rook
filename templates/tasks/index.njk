{% extends 'layouts/default' %}

{% block head %}
<script>
  document.addEventListener(`alpine:init`, () => {
    // A note cut to a few lines, with Show more under it when some of it is cut off
    Alpine.data(`clampedText`, () => ({
      expanded: false,
      // Whether the text is cut off. It's measured again whenever its size changes: when the
      // window is resized, when the Done list is opened, and after editing.
      clamped: false,

      init () {
        new ResizeObserver(() => this.measure()).observe(this.$refs.text)
      },

      measure () {
        // While expanded nothing is cut off, so keep what was measured before
        if (this.expanded === false) {
          this.clamped = this.$refs.text.scrollHeight > this.$refs.text.clientHeight
        }
      },
    }))
  })
</script>
{% endblock %}

{% block body %}
  {# Who asked for it, when another user did, then the priority and due date, as small labels
     beside a task or a task request #}
  {% macro taskLabels(task) %}
    {% if task.fromName %}
      <span class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700">From {{ task.fromName }}</span>
    {% endif %}

    {% if task.priority == 'high' %}
      <span class="px-2 py-0.5 rounded-full bg-orange-100 text-orange-800">High</span>
    {% elif task.priority == 'low' %}
      <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-500">Low</span>
    {% endif %}

    {% if task.dueLabel %}
      {% if task.dueState == 'overdue' %}
        {% set dueColors = 'bg-red-50 text-red-700' %}
      {% elif task.dueState == 'today' %}
        {% set dueColors = 'bg-amber-50 text-amber-800' %}
      {% elif task.dueState == 'tomorrow' %}
        {% set dueColors = 'bg-sky-50 text-sky-700' %}
      {% else %}
        {% set dueColors = 'bg-gray-100 text-gray-600' %}
      {% endif %}
      <span class="px-2 py-0.5 rounded-full {{ dueColors }}">{{ task.dueLabel }}</span>
    {% endif %}
  {% endmacro %}

  {# Delete asks first, as deleting a chat does #}
  {% macro deleteControls(task, returnTo) %}
    <div x-show="!confirmDelete" class="flex items-center gap-1">
      {{ caller() if caller else '' }}
      <button type="button" class="px-2 py-1 rounded hover:bg-red-50 hover:text-red-600" @click="confirmDelete = true">Delete</button>
    </div>

    <form x-cloak x-show="confirmDelete" method="post" action="/tasks/{{ task.id }}/delete"
      class="flex items-center gap-2" @keydown.escape="confirmDelete = false">
      <input type="hidden" name="returnTo" value="{{ returnTo }}">
      <span class="text-gray-600">Delete this task?</span>
      <button type="submit" class="px-2 py-1 font-bold text-white bg-red-600 hover:bg-red-700 rounded">Delete</button>
      <button type="button" class="px-2 py-1 rounded hover:bg-gray-100" @click="confirmDelete = false">Cancel</button>
    </form>
  {% endmacro %}

  {# The title, priority, due date and notes, as the add and edit forms ask for them #}
  {% macro taskFields(task, idPrefix) %}
    <label class="sr-only" for="{{ idPrefix }}-title">Task</label>
    <input id="{{ idPrefix }}-title" name="title" value="{{ task.title if task else '' }}" required maxlength="200"
      placeholder="Add a task…" autocomplete="off"
      class="flex-1 min-w-48 p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">

    <label class="sr-only" for="{{ idPrefix }}-priority">Priority</label>
    <select id="{{ idPrefix }}-priority" name="priority" class="form-select py-2 pl-2 pr-8 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
      {% set current = task.priority if task else 'normal' %}
      <option value="high" {% if current == 'high' %}selected{% endif %}>High</option>
      <option value="normal" {% if current == 'normal' %}selected{% endif %}>Normal</option>
      <option value="low" {% if current == 'low' %}selected{% endif %}>Low</option>
    </select>

    <label class="sr-only" for="{{ idPrefix }}-due">Due date</label>
    <input id="{{ idPrefix }}-due" type="date" name="dueDate" value="{{ task.dueDate if task and task.dueDate else '' }}"
      class="p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
  {% endmacro %}

  {# A task still to do, in the list or in search results. `returnTo` is the page to come back to
     once it's completed, edited or deleted, so a search stays open. #}
  {% macro openTaskItem(task, returnTo) %}
    <li class="px-4 py-3" x-data="{ editing: false, confirmDelete: false, completing: false }">
      <div x-show="!editing" class="flex items-start gap-3">
        {# Ticking it opens the completion form below; unticking it is the same as Cancel #}
        <div class="pt-0.5">
          <input type="checkbox" x-model="completing" class="size-4 rounded border-gray-300 text-sky-600 focus:ring-sky-500 cursor-pointer"
            aria-label="Mark done: {{ task.title }}" @change="if (!$el.checked) $refs.completeForm.reset()">
        </div>

        <div class="flex-1 min-w-0">
          <p class="text-sm wrap-break-word">{{ task.title }}</p>

          {% if task.notes %}
            {# Cut to 3 lines; Show more, or a click on the text, shows all of it #}
            <div x-data="clampedText">
              <p x-ref="text" class="mt-0.5 text-xs text-gray-500 whitespace-pre-wrap wrap-break-word line-clamp-3"
                :class="{ 'line-clamp-3': !expanded, 'cursor-pointer': clamped && !expanded }"
                @click="if (clamped) expanded = true">{{ task.notes }}</p>
              <button type="button" x-cloak x-show="clamped" class="mt-0.5 text-xs text-sky-600 hover:underline"
                :aria-expanded="expanded" @click="expanded = !expanded" x-text="expanded ? 'Show less' : 'Show more'">Show more</button>
            </div>
          {% endif %}

          {# One the model accepted from another user, with why #}
          {% if task.acceptedBy == 'model' %}
            <p class="mt-0.5 text-xs text-gray-500 wrap-break-word">Accepted for you by Rook{% if task.acceptNote %}: {{ task.acceptNote }}{% endif %}</p>
          {% endif %}

          <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500">
            {{ taskLabels(task) }}

            {% if task.chatId %}
              <a href="/chat/{{ task.chatId }}" class="min-w-0 max-w-full truncate underline hover:text-gray-800">From {{ task.chatTitle or 'a chat' }}</a>
            {% endif %}

            <span class="flex-1"></span>

            {% call deleteControls(task, returnTo) %}
              {# Opens a new chat with the task as the model's first message #}
              <form method="post" action="/tasks/{{ task.id }}/discuss">
                <input type="hidden" name="returnTo" value="{{ returnTo }}">
                <button type="submit" class="px-2 py-1 rounded hover:bg-sky-50 hover:text-sky-600">Discuss</button>
              </form>
              <button type="button" class="px-2 py-1 rounded hover:bg-gray-100 hover:text-gray-800"
                @click="editing = true; $nextTick(() => $refs.editForm.elements.title.focus())">Edit</button>
            {% endcall %}
          </div>

          {# Completing takes a second click, so a stray tick can be cancelled. The note
             box doesn't take focus, so a phone's keyboard only comes up for a note.
             Cancel unticks the box and clears what was typed. #}
          <form x-cloak x-show="completing" x-ref="completeForm" method="post" action="/tasks/{{ task.id }}/done" class="mt-2 space-y-2"
            @keydown.escape="completing = false; $refs.completeForm.reset()">
            <input type="hidden" name="done" value="true">
            <input type="hidden" name="returnTo" value="{{ returnTo }}">
            <label class="sr-only" for="task-{{ task.id }}-complete-note">Completion note</label>
            <textarea id="task-{{ task.id }}-complete-note" name="doneNote" rows="2" maxlength="{{ maxDoneNoteLength }}"
              placeholder="Completion note (optional): how it went, anything left over, or why it no longer applies"
              class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600"></textarea>

            {% if task.fromName %}
              <p class="text-xs text-gray-500">{{ task.fromName }} asked for this, and will see that it's done, with this note.</p>
            {% endif %}

            <div class="flex justify-end gap-2">
              <button type="button" class="px-3 py-1.5 text-sm rounded-md hover:bg-gray-100" @click="completing = false; $refs.completeForm.reset()">Cancel</button>
              <button type="submit" class="px-3 py-1.5 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-md">Complete</button>
            </div>
          </form>
        </div>
      </div>

      {# Cancel puts the form back as it was #}
      <form x-cloak x-show="editing" x-ref="editForm" method="post" action="/tasks/{{ task.id }}/update" class="space-y-2"
        @keydown.escape="editing = false; $refs.editForm.reset()">
        <input type="hidden" name="returnTo" value="{{ returnTo }}">
        <div class="flex flex-wrap items-center gap-2">
          {{ taskFields(task, 'task-' + task.id) }}
        </div>

        <label class="sr-only" for="task-{{ task.id }}-notes">Notes</label>
        <textarea id="task-{{ task.id }}-notes" name="notes" rows="2" maxlength="4000" placeholder="Notes"
          class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">{{ task.notes }}</textarea>

        <div class="flex justify-end gap-2">
          <button type="button" class="px-3 py-1.5 text-sm rounded-md hover:bg-gray-100" @click="editing = false; $refs.editForm.reset()">Cancel</button>
          <button type="submit" class="px-3 py-1.5 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-md">Save</button>
        </div>
      </form>
    </li>
  {% endmacro %}

  {# A done task, in the Done list or in search results. `returnTo` is the page to come back to once
     it's put back, its note changed or it's deleted, so a search stays open. #}
  {% macro doneTaskItem(task, returnTo) %}
    <li class="flex items-start gap-3 px-4 py-3" x-data="{ confirmDelete: false, editingNote: false }">
      {# Unticking it puts it back on the list, and removes its completion note #}
      <form method="post" action="/tasks/{{ task.id }}/done" class="pt-0.5">
        <input type="hidden" name="done" value="false">
        <input type="hidden" name="returnTo" value="{{ returnTo }}">
        <input type="checkbox" checked class="size-4 rounded border-gray-300 text-sky-600 focus:ring-sky-500 cursor-pointer"
          aria-label="Put back on the list: {{ task.title }}" @change="$el.form.submit()">
      </form>

      <div class="flex-1 min-w-0">
        <p class="text-sm text-gray-500 line-through wrap-break-word">{{ task.title }}</p>

        {% if task.doneNote %}
          {# Cut to 3 lines, as a task's notes are #}
          <div x-show="!editingNote" x-data="clampedText">
            <p x-ref="text" class="mt-0.5 text-xs text-gray-600 whitespace-pre-wrap wrap-break-word line-clamp-3"
              :class="{ 'line-clamp-3': !expanded, 'cursor-pointer': clamped && !expanded }"
              @click="if (clamped) expanded = true">{{ task.doneNote }}</p>
            <button type="button" x-cloak x-show="clamped" class="mt-0.5 text-xs text-sky-600 hover:underline"
              :aria-expanded="expanded" @click="expanded = !expanded" x-text="expanded ? 'Show less' : 'Show more'">Show more</button>
          </div>
        {% endif %}

        {# Cancel puts the note back as it was; saving it empty removes it #}
        <form x-cloak x-show="editingNote" x-ref="noteForm" method="post" action="/tasks/{{ task.id }}/note" class="mt-2 space-y-2"
          @keydown.escape="editingNote = false; $refs.noteForm.reset()">
          <input type="hidden" name="returnTo" value="{{ returnTo }}">
          <label class="sr-only" for="task-{{ task.id }}-done-note">Completion note</label>
          <textarea id="task-{{ task.id }}-done-note" name="doneNote" rows="2" maxlength="{{ maxDoneNoteLength }}"
            placeholder="How it went, anything left over, or why it no longer applies"
            class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">{{ task.doneNote }}</textarea>

          <div class="flex justify-end gap-2">
            <button type="button" class="px-3 py-1.5 text-sm rounded-md hover:bg-gray-100" @click="editingNote = false; $refs.noteForm.reset()">Cancel</button>
            <button type="submit" class="px-3 py-1.5 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-md">Save</button>
          </div>
        </form>

        <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500">
          <span>Done {{ task.doneLabel }}</span>
          {% if task.fromName %}
            <span class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700">From {{ task.fromName }}</span>
          {% endif %}
          <span class="flex-1"></span>
          {% call deleteControls(task, returnTo) %}
            <button type="button" x-show="!editingNote" class="px-2 py-1 rounded hover:bg-gray-100 hover:text-gray-800"
              @click="editingNote = true; $nextTick(() => $refs.noteForm.elements.doneNote.focus())">{{ 'Edit note' if task.doneNote else 'Add note' }}</button>
          {% endcall %}
        </div>
      </div>
    </li>
  {% endmacro %}

  {# A task request another user sent, that's the user's to answer: one held for them, or
     (`declined`) one the model turned down, which they can still accept #}
  {% macro incomingRequestItem(request, declined) %}
    <li class="px-4 py-3" x-data="{ declining: false }">
      <p class="text-sm wrap-break-word {% if declined %}text-gray-500{% endif %}">{{ request.title }}</p>

      {% if request.notes %}
        <p class="mt-0.5 text-xs text-gray-500 whitespace-pre-wrap wrap-break-word">{{ request.notes }}</p>
      {% endif %}

      {# Why the model held or declined it; only the user is shown this #}
      {% if declined %}
        <p class="mt-1 text-xs text-gray-600 wrap-break-word">Rook declined it for you on {{ request.answeredLabel }}{% if request.answerNote %}: {{ request.answerNote }}{% endif %}</p>
      {% elif request.answerNote %}
        <p class="mt-1 text-xs text-gray-600 wrap-break-word">Rook left it for you: {{ request.answerNote }}</p>
      {% endif %}

      <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500">
        {{ taskLabels(request) }}
        <span>Sent {{ request.sentLabel }}</span>
        <span class="flex-1"></span>

        <div x-show="!declining" class="flex items-center gap-1">
          {% if not declined %}
            <button type="button" class="px-2 py-1 rounded hover:bg-red-50 hover:text-red-600"
              @click="declining = true; $nextTick(() => $refs.reason.focus())">Decline</button>
          {% endif %}
          <form method="post" action="/tasks/requests/{{ request.id }}/accept">
            {% if declined %}
              <button type="submit" class="px-2 py-1 rounded hover:bg-sky-50 hover:text-sky-600">Accept anyway</button>
            {% else %}
              <button type="submit" class="px-2 py-1 font-bold text-white bg-sky-500 hover:bg-sky-600 rounded">Accept</button>
            {% endif %}
          </form>
        </div>
      </div>

      {% if not declined %}
        {# Declining takes a second click, and can say why. Cancel clears what was typed. #}
        <form x-cloak x-show="declining" x-ref="declineForm" method="post" action="/tasks/requests/{{ request.id }}/decline" class="mt-2 space-y-2"
          @keydown.escape="declining = false; $refs.declineForm.reset()">
          <label class="sr-only" for="request-{{ request.id }}-reason">Reason</label>
          <textarea x-ref="reason" id="request-{{ request.id }}-reason" name="reason" rows="2" maxlength="{{ maxReasonLength }}"
            placeholder="Reason (optional). {{ request.fromName }} will see it."
            class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600"></textarea>

          <div class="flex justify-end gap-2">
            <button type="button" class="px-3 py-1.5 text-sm rounded-md hover:bg-gray-100" @click="declining = false; $refs.declineForm.reset()">Cancel</button>
            <button type="submit" class="px-3 py-1.5 text-sm font-bold text-white bg-red-600 hover:bg-red-700 rounded-md">Decline</button>
          </div>
        </form>
      {% endif %}
    </li>
  {% endmacro %}

  {# A task request the user sent someone, with where it stands #}
  {% macro sentRequestItem(request) %}
    {% set isOpen = request.state == 'reviewing' or request.state == 'waiting' or request.state == 'accepted' %}
    <li class="px-4 py-3">
      <p class="text-sm wrap-break-word {% if not isOpen %}text-gray-500{% endif %} {% if request.state == 'done' %}line-through{% endif %}">{{ request.title }}</p>

      {% if request.notes %}
        <p class="mt-0.5 text-xs text-gray-500 whitespace-pre-wrap wrap-break-word line-clamp-3">{{ request.notes }}</p>
      {% endif %}

      {# What the other person wrote back: their completion note, or why they declined #}
      {% if request.doneNote %}
        <p class="mt-1 text-xs text-gray-600 whitespace-pre-wrap wrap-break-word">{{ request.toName }}: {{ request.doneNote }}</p>
      {% elif request.declineReason %}
        <p class="mt-1 text-xs text-gray-600 whitespace-pre-wrap wrap-break-word">{{ request.toName }}: {{ request.declineReason }}</p>
      {% endif %}

      <div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500">
        <span class="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700">To {{ request.toName }}</span>

        {% if request.state == 'reviewing' %}
          <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">Their Rook is looking at it</span>
        {% elif request.state == 'waiting' %}
          <span class="px-2 py-0.5 rounded-full bg-amber-50 text-amber-800">Waiting for {{ request.toName }}</span>
        {% elif request.state == 'accepted' %}
          <span class="px-2 py-0.5 rounded-full bg-sky-50 text-sky-700">On their list since {{ request.answeredLabel }}</span>
        {% elif request.state == 'done' %}
          <span class="px-2 py-0.5 rounded-full bg-green-50 text-green-700">Done {{ request.doneLabel }}</span>
        {% elif request.state == 'declined' %}
          <span class="px-2 py-0.5 rounded-full bg-red-50 text-red-700">Declined {{ request.answeredLabel }}{% if request.answeredBy == 'model' %} by their Rook{% endif %}</span>
        {% else %}
          <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-600">Accepted, then removed from their list</span>
        {% endif %}

        {% if isOpen %}
          {{ taskLabels(request) }}
        {% endif %}

        <span>Sent {{ request.sentLabel }}</span>
        <span class="flex-1"></span>

        {% if request.state == 'reviewing' or request.state == 'waiting' %}
          <form method="post" action="/tasks/requests/{{ request.id }}/withdraw">
            <button type="submit" class="px-2 py-1 rounded hover:bg-red-50 hover:text-red-600">Withdraw</button>
          </form>
        {% endif %}
      </div>
    </li>
  {% endmacro %}

  <div class="max-w-3xl">
    <h1 class="text-2xl font-bold">Tasks</h1>
    <p class="mt-1 mb-6 text-sm text-gray-500">
      {{ openTasks.length }} to do{% if dueCount > 0 %} · <span class="font-semibold text-red-700">{{ dueCount }} due today or overdue</span>{% endif %}.
      The chat model can add, find, change and complete them; only you can delete them, and done ones are deleted {{ doneKeptDays }} days after they're done.
      Discuss opens a chat about a task.
    </p>

    <div class="space-y-6">
      {% if not isTasksOn %}
        <div class="flex flex-wrap items-center gap-3 p-4 text-sm rounded-lg border border-amber-200 bg-amber-50 text-amber-900" role="alert">
          <span class="flex-1">Tasks are off in Admin → Tools, so the chat model can't see or change them.</span>
        </div>
      {% endif %}

      {# Task requests from other users that are the user's to answer #}
      {% if heldRequests.length > 0 or declinedRequests.length > 0 %}
        <section class="bg-white rounded-lg shadow-sm">
          <div class="px-4 py-3 border-b border-gray-200">
            <h2 class="font-bold">Asked of you</h2>
            <p class="mt-0.5 text-xs text-gray-500">Tasks other people here have asked you to do. Rook looks at each one first, going by <a href="/settings/people" class="underline hover:text-gray-800">your note about them</a>; these it left for you, or declined in the last {{ recentDays }} days.</p>
          </div>

          <ul class="divide-y divide-gray-100">
            {% for request in heldRequests %}
              {{ incomingRequestItem(request, false) }}
            {% endfor %}
            {% for request in declinedRequests %}
              {{ incomingRequestItem(request, true) }}
            {% endfor %}
          </ul>
        </section>
      {% endif %}

      {# Finds tasks by meaning with the embedding model, as the chat model does #}
      <form method="get" action="/tasks" role="search" class="flex flex-wrap items-center gap-2 p-4 bg-white rounded-lg shadow-sm"
        x-data="{ searching: false }" @submit="searching = true">
        <label for="task-search" class="sr-only">Search tasks</label>
        <input id="task-search" type="search" name="q" value="{{ q }}" placeholder="Search by meaning, e.g. call the plumber"
          class="flex-1 min-w-48 p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
        <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg disabled:opacity-50"
          :disabled="searching" x-text="searching ? 'Searching…' : 'Search'">Search</button>
      </form>

      <form method="post" action="/tasks" class="p-4 bg-white rounded-lg shadow-sm" x-data="{ showNotes: false }">
        <div class="flex flex-wrap items-center gap-2">
          {{ taskFields(null, 'new-task') }}
          <button type="submit" class="flex items-center gap-1.5 px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg">
            <span class="icon-plus inline-block size-4 bg-current" aria-hidden="true"></span>
            Add
          </button>
        </div>

        <button type="button" x-show="!showNotes" class="mt-2 text-xs text-gray-500 hover:text-gray-800"
          @click="showNotes = true; $nextTick(() => $refs.notes.focus())">+ Add notes</button>
        <label class="sr-only" for="new-task-notes">Notes</label>
        <textarea x-cloak x-show="showNotes" x-ref="notes" id="new-task-notes" name="notes" rows="2" maxlength="4000" placeholder="Notes"
          class="mt-2 w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600"></textarea>
      </form>

      {% if q %}
        <section class="bg-white rounded-lg shadow-sm">
          <div class="flex flex-wrap items-start gap-3 px-4 py-3 border-b border-gray-200">
            <div class="flex-1 min-w-0">
              <h2 class="font-bold wrap-break-word">Closest to “{{ q }}”</h2>
              <p class="mt-0.5 text-xs text-gray-500">Found by meaning, closest first. Done tasks are included.</p>
            </div>
            <a href="/tasks" class="px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50">Clear</a>
          </div>

          {% if searchError %}
            <div class="m-4 p-4 text-sm rounded-lg border border-red-200 bg-red-50 text-red-800" role="alert">{{ searchError }}</div>
          {% elif results.length == 0 %}
            <p class="px-4 py-3 text-sm text-gray-500">There are no tasks to search.</p>
          {% else %}
            <ul class="divide-y divide-gray-100">
              {% for task in results %}
                {% if task.doneAt %}
                  {{ doneTaskItem(task, returnTo) }}
                {% else %}
                  {{ openTaskItem(task, returnTo) }}
                {% endif %}
              {% endfor %}
            </ul>
          {% endif %}
        </section>
      {% else %}
        <section class="bg-white rounded-lg shadow-sm">
          {% if openTasks.length == 0 %}
            <p class="p-4 text-sm text-gray-500">Nothing to do.</p>
          {% else %}
            <ul class="divide-y divide-gray-100">
              {% for task in openTasks %}
                {{ openTaskItem(task, returnTo) }}
              {% endfor %}
            </ul>
          {% endif %}
        </section>

        {% if doneCount > 0 %}
          <details class="bg-white rounded-lg shadow-sm">
            <summary class="px-4 py-3 text-sm font-bold cursor-pointer select-none">
              Done <span class="font-normal text-gray-500">· {{ doneCount }}</span>
            </summary>

            <ul class="border-t border-gray-200 divide-y divide-gray-100">
              {% for task in doneTasks %}
                {{ doneTaskItem(task, returnTo) }}
              {% endfor %}
            </ul>

            <p class="px-4 py-2 text-xs text-gray-500 border-t border-gray-100">
              {% if doneCount > doneTasks.length %}Showing the {{ doneTasks.length }} done most recently. {% endif %}Done tasks are deleted {{ doneKeptDays }} days after they're done.
            </p>
          </details>
        {% endif %}

        {# What the user has asked of other users; open while any is still to be done #}
        {% if sentRequests.length > 0 %}
          <details class="bg-white rounded-lg shadow-sm" {% if sentOpenCount > 0 %}open{% endif %}>
            <summary class="px-4 py-3 text-sm font-bold cursor-pointer select-none">
              Asked of others <span class="font-normal text-gray-500">· {{ sentOpenCount }} open</span>
            </summary>

            <ul class="border-t border-gray-200 divide-y divide-gray-100">
              {% for request in sentRequests %}
                {{ sentRequestItem(request) }}
              {% endfor %}
            </ul>

            <p class="px-4 py-2 text-xs text-gray-500 border-t border-gray-100">
              Ask someone in a chat, e.g. “ask Dana to order paper by Friday”. Their Rook looks at each request first. Declined and done ones are removed after {{ doneKeptDays }} days.
            </p>
          </details>
        {% endif %}
      {% endif %}
    </div>
  </div>
{% endblock body %}
