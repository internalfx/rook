{% extends 'layouts/default' %}

{# The settings scroll above a bar along the bottom, so Save stays in reach however long they get #}
{% block mainClass %}flex flex-col overflow-hidden{% endblock %}

{% block body %}
  {# One choice per model: its name, labels, size and context length #}
  {% macro modelOption(name, model, current) %}
    <label class="flex items-start gap-3 px-4 py-3 cursor-pointer hover:bg-gray-50">
      <input type="radio" name="{{ name }}" value="{{ model.id }}" class="mt-0.5 text-sky-600 focus:ring-sky-500"
        {% if model.id == current %}checked{% endif %} required>
      <span class="flex-1 min-w-0">
        <span class="block text-sm font-medium break-words">{{ model.id }}</span>
        <span class="mt-1 flex flex-wrap items-center gap-1 text-xs text-gray-500">
          {% for label in model.labels %}
            <span class="px-2 py-0.5 rounded-full bg-gray-100 text-gray-700">{{ label }}</span>
          {% endfor %}
          {% if model.sizeGB != null %}<span class="ml-1">{{ model.sizeGB }} GB</span>{% endif %}
          {% if model.contextLength %}<span class="ml-1">· {{ model.contextLength }} context</span>{% endif %}
        </span>
      </span>
    </label>
  {% endmacro %}

  {# An on/off switch: a checkbox, sent as "true" when on and left out of the form when off.
     `xModel` names an Alpine variable to keep in step with it, for parts that dim when it's off. #}
  {% macro toggleSwitch(name, label, on, xModel) %}
    <label class="relative inline-flex shrink-0 items-center cursor-pointer">
      <input type="checkbox" name="{{ name }}" value="true" class="peer sr-only"
        {% if xModel %}x-model="{{ xModel }}"{% endif %} {% if on %}checked{% endif %}>
      <span class="sr-only">{{ label }}</span>
      <span class="h-6 w-11 rounded-full bg-gray-300 transition-colors peer-checked:bg-sky-500 peer-focus-visible:ring-2 peer-focus-visible:ring-sky-500 peer-focus-visible:ring-offset-2" aria-hidden="true"></span>
      <span class="absolute top-0.5 left-0.5 size-5 rounded-full bg-white shadow transition-transform peer-checked:translate-x-5" aria-hidden="true"></span>
    </label>
  {% endmacro %}

  <div class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-8">
    <h1 class="text-2xl font-bold">Settings</h1>
    <p class="mt-1 mb-6 text-sm text-gray-500">Changes apply to every chat right away, including chats already open, from their next message.</p>

    {% if modelsError %}
      <div class="max-w-3xl p-4 text-sm rounded-lg border border-red-200 bg-red-50 text-red-800" role="alert">
        Couldn't load models: {{ modelsError }}
      </div>
    {% else %}
      <form id="settings-form" method="post" action="/settings" class="max-w-3xl space-y-6">
        <fieldset class="bg-white rounded-lg shadow-sm">
          <div class="px-4 py-3 border-b border-gray-200">
            <legend class="font-bold">Chat model</legend>
            <p class="mt-0.5 text-xs text-gray-500">Used for every chat, and for writing chat titles.</p>
          </div>

          {% if chatModels.length == 0 %}
            <p class="p-4 text-sm text-gray-500">The Lemonade server has no chat models.</p>
          {% else %}
            {% if chatModel and not isChatModelListed %}
              <div class="m-4 p-4 text-sm rounded-lg border border-amber-200 bg-amber-50 text-amber-900" role="alert">
                The current model, "{{ chatModel }}", isn't on the Lemonade server any more. Choose another one.
              </div>
            {% endif %}

            <div class="divide-y divide-gray-100">
              {% for model in chatModels %}
                {{ modelOption('chatModel', model, chatModel) }}
              {% endfor %}
            </div>
          {% endif %}
        </fieldset>

        <fieldset class="bg-white rounded-lg shadow-sm">
          <div class="px-4 py-3 border-b border-gray-200">
            <legend class="font-bold">Image model</legend>
            <p class="mt-0.5 text-xs text-gray-500">Lets the chat model create images when you ask for them. Choose Off to turn image generation off.</p>
          </div>

          {% if imageModel and not isImageModelListed %}
            <div class="m-4 p-4 text-sm rounded-lg border border-amber-200 bg-amber-50 text-amber-900" role="alert">
              The current model, "{{ imageModel }}", isn't on the Lemonade server any more. Choose another one, or Off.
            </div>
          {% endif %}

          <div class="divide-y divide-gray-100">
            <label class="flex items-start gap-3 px-4 py-3 cursor-pointer hover:bg-gray-50">
              <input type="radio" name="imageModel" value="{{ noImageModel }}" class="mt-0.5 text-sky-600 focus:ring-sky-500"
                {% if not imageModel %}checked{% endif %} required>
              <span class="text-sm font-medium">Off</span>
            </label>

            {% for model in imageModels %}
              {{ modelOption('imageModel', model, imageModel) }}
            {% endfor %}
          </div>
        </fieldset>

        <fieldset class="bg-white rounded-lg shadow-sm">
          <div class="px-4 py-3 border-b border-gray-200">
            <legend class="font-bold">Image size</legend>
            <p class="mt-0.5 text-xs text-gray-500">Larger images take longer, and Qwen-Image can take several minutes at Large.</p>
          </div>

          <div class="divide-y divide-gray-100">
            {% for option in imageSizeOptions %}
              <label class="flex items-center gap-3 px-4 py-3 cursor-pointer hover:bg-gray-50">
                <input type="radio" name="imageSize" value="{{ option.value }}" class="text-sky-600 focus:ring-sky-500"
                  {% if option.value == imageSize %}checked{% endif %} required>
                <span class="text-sm font-medium">{{ option.name }}</span>
                <span class="text-xs text-gray-500">{{ option.dimensions }}</span>
              </label>
            {% endfor %}
          </div>
        </fieldset>

        {# Switched off, the sites stay listed (and are still sent with the form) for next time #}
        <fieldset class="bg-white rounded-lg shadow-sm" x-data="{ webPagesOn: {{ 'true' if isWebPagesOn else 'false' }} }">
          <div class="flex items-start gap-4 px-4 py-3 border-b border-gray-200">
            <div class="flex-1 min-w-0">
              <legend class="font-bold">Web pages</legend>
              <p class="mt-0.5 text-xs text-gray-500">Lets the chat model read pages on these sites when you ask about them.</p>
            </div>

            {{ toggleSwitch('webPagesOn', 'Read web pages', isWebPagesOn, 'webPagesOn') }}
          </div>

          <div class="px-4 py-3 transition-opacity" :class="{ 'opacity-50': !webPagesOn }">
            <label for="webDomains" class="block text-sm font-medium">Sites</label>
            <p class="mt-0.5 mb-2 text-xs text-gray-500">One site per line. Each covers its subdomains too: github.com includes www.github.com. Leave it empty to turn web pages off.</p>
            <textarea id="webDomains" name="webDomains" rows="4" placeholder="github.com" spellcheck="false" autocapitalize="off"
              class="w-full p-2 font-mono text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">{{ webDomainsText }}</textarea>
          </div>
        </fieldset>

        <fieldset class="bg-white rounded-lg shadow-sm">
          <div class="flex items-start gap-4 px-4 py-3">
            <div class="flex-1 min-w-0">
              <legend class="font-bold">Web search</legend>
              <p class="mt-0.5 text-xs text-gray-500">Lets the chat model search the web with DuckDuckGo, so the searches it makes for your questions are sent there. It can only open results on the sites listed under Web pages; for the rest it gets their titles and snippets.</p>
            </div>

            {{ toggleSwitch('webSearchOn', 'Search the web', isWebSearchOn) }}
          </div>
        </fieldset>
      </form>
    {% endif %}
  </div>

  {% if not modelsError %}
    <div class="shrink-0 px-4 py-3 sm:px-8 bg-white border-t border-gray-200">
      <div class="max-w-3xl">
        <button type="submit" form="settings-form" class="px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg">Save</button>
      </div>
    </div>
  {% endif %}
{% endblock body %}
