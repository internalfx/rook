{% extends 'layouts/default' %}

{# The settings scroll above a bar along the bottom, so Save stays in reach however long they get #}
{% block mainClass %}flex flex-col overflow-hidden{% endblock %}

{% block head %}
<script>
  document.addEventListener(`alpine:init`, () => {
    // Grows a textarea to fit its text, up to its max-height, after which it scrolls. Clearing
    // the height first lets it shrink again; its rows are the smallest it gets.
    Alpine.magic(`fitHeight`, () => function (el) {
      el.style.height = ``
      // scrollHeight leaves out the border, which the box's height includes
      el.style.height = `${el.scrollHeight + el.offsetHeight - el.clientHeight}px`
    })

    // Asks before leaving with unsaved changes. Links within rook get a dialog that can save
    // first; anything else (closing the tab, reloading, going back) gets the browser's own prompt.
    Alpine.data(`settingsForm`, () => ({
      // The form as it loaded, to compare against
      savedState: ``,
      isDirty: false,
      // Set when saving or choosing "Don't save", so the browser's prompt doesn't follow
      isLeaving: false,
      // Where the link in the dialog was going
      leaveTo: null,

      init () {
        this.savedState = this.readState()

        window.addEventListener(`beforeunload`, (event) => {
          if (this.isDirty === true && this.isLeaving === false) {
            event.preventDefault()
            // Older Safari only shows the prompt when this is set
            event.returnValue = ``
          }
        })

        document.addEventListener(`click`, (event) => this.onLinkClick(event))
      },

      readState () {
        const data = new FormData(this.$root)
        return new URLSearchParams(data).toString()
      },

      // A change made and then undone isn't a change
      checkDirty () {
        this.isDirty = this.readState() !== this.savedState
      },

      onLinkClick (event) {
        if (this.isDirty === false || this.isLeaving === true || event.defaultPrevented === true) {
          return
        }

        // These open the link somewhere else, so the page stays
        const hasModifier = event.metaKey || event.ctrlKey || event.shiftKey || event.altKey

        if (event.button !== 0 || hasModifier) {
          return
        }

        const link = event.target.closest(`a[href]`)

        if (link == null || link.target === `_blank`) {
          return
        }

        // A link to another site leaves rook, so it gets the browser's prompt instead
        const url = new URL(link.href, window.location.href)

        if (url.origin !== window.location.origin) {
          return
        }

        event.preventDefault()
        this.leaveTo = `${url.pathname}${url.search}${url.hash}`
        this.$refs.leaveDialog.showModal()
      },

      // Saving redirects to where the link was going (see POST in routes/settings/index.js). The
      // browser checks the form first, as the Save button does.
      saveAndLeave () {
        this.$refs.leaveDialog.close()
        this.$refs.returnTo.value = this.leaveTo
        this.$root.requestSubmit()
      },

      leaveWithoutSaving () {
        this.isLeaving = true
        window.location.href = this.leaveTo
      },
    }))

    // "Send a test": pushes to the ntfy topic typed in the form, saved or not, without submitting
    // the form, so unsaved changes stay
    Alpine.data(`ntfyTest`, () => ({
      isSending: false,
      result: null,
      isOk: false,

      async send () {
        this.isSending = true
        this.result = null

        try {
          const response = await fetch(`/notifications/test`, {
            method: `POST`,
            headers: { 'Content-Type': `application/json` },
            body: JSON.stringify({ url: this.$refs.ntfyUrl.value, token: this.$refs.ntfyToken.value }),
          })
          const body = await response.json()

          this.isOk = body.ok === true
          this.result = this.isOk ? `Sent. It should be on your phone now.` : `Couldn't send: ${body.error}`
        } catch (err) {
          this.isOk = false
          this.result = `Couldn't send: ${err.message}`
        } finally {
          this.isSending = false
        }
      },
    }))
  })
</script>
{% endblock %}

{% block body %}
  <div class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-8">
    <h1 class="text-2xl font-bold">Settings</h1>
    <p class="mt-1 mb-6 text-sm text-gray-500">Yours alone. The models, tools and briefing schedule are set for everyone in config.js.</p>

    <form id="settings-form" method="post" action="/settings" class="space-y-6 max-w-3xl"
      x-data="settingsForm" @input="checkDirty()" @change="checkDirty()" @submit="isLeaving = true">
      {# Set by the leave dialog's Save, so saving goes on to where the link was going #}
      <input type="hidden" name="returnTo" x-ref="returnTo">

      {# Where "today", due dates and the times of notifications and briefings are worked out #}
      <fieldset class="bg-white rounded-lg shadow-sm" x-data="{ browserZone: Intl.DateTimeFormat().resolvedOptions().timeZone, zone: '{{ timeZone }}' }">
        <div class="px-4 py-3 border-b border-gray-200">
          <legend class="font-bold">Time zone</legend>
          <p class="mt-0.5 text-xs text-gray-500">Where you are: what Rook counts as today, when a task is due, and when notifications and briefings are shown as happening. Until you choose, it's the server's, {{ serverTimeZone }}.</p>
        </div>

        <div class="px-4 py-3">
          <select id="timeZone" x-ref="timeZone" x-model="zone" name="timeZone" aria-label="Time zone"
            class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
            {% for zone in timeZones %}
              <option value="{{ zone }}" {% if zone == timeZone %}selected{% endif %}>{{ zone }}</option>
            {% endfor %}
          </select>

          {# Offered when the browser is somewhere else; choosing it counts as a change to save, so
             the form is told once the select has it #}
          <p x-cloak x-show="browserZone !== zone" class="mt-2 text-xs text-gray-500">
            This browser is in <span x-text="browserZone"></span>.
            <button type="button" class="underline hover:text-gray-800"
              @click="zone = browserZone; $nextTick(() => $refs.timeZone.dispatchEvent(new Event('change', { bubbles: true })))">Use that</button>
          </p>
        </div>
      </fieldset>

      {# Only the conversations ticked here are read. The filter box has no name, so it isn't sent
         with the form or counted as a change. #}
      <fieldset class="bg-white rounded-lg shadow-sm" x-data="{ filter: '' }">
        <div class="px-4 py-3 border-b border-gray-200">
          <legend class="font-bold">Slack</legend>
          <p class="mt-0.5 text-xs text-gray-500">Lets the chat model and briefings read the Slack conversations you tick here, and only those, as you. Nothing is ever posted to Slack.</p>
        </div>

        <div class="px-4 py-3 border-b border-gray-100">
          <label for="slackToken" class="block text-sm font-medium">Your Slack user token</label>
          <p class="mt-0.5 mb-1 text-xs text-gray-500">A user token (it starts with xoxp-) from a Slack app installed to your workspace. Rook reads Slack as you with it, so it sees what you see. Leave it empty to keep Rook out of Slack; the conversations you ticked are kept for when you add one again.</p>
          <input id="slackToken" type="password" name="slackToken" value="{{ slackToken or '' }}" placeholder="xoxp-…"
            spellcheck="false" autocapitalize="off" autocomplete="off"
            class="w-full p-2 font-mono text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
        </div>

        {% if not isSlackConfigured %}
          <p class="px-4 py-3 text-sm text-gray-500">Add your Slack user token above and save to choose what Rook reads.</p>
        {% elif slackError %}
          <div class="m-4 p-4 text-sm rounded-lg border border-red-200 bg-red-50 text-red-800" role="alert">
            Couldn't read Slack: {{ slackError }}
          </div>
          {% if slackPicks.length > 0 %}
            <p class="px-4 pb-3 text-sm text-gray-700">
              Reading:
              {% for conversation in slackPicks %}{{ conversation.label }}{% if not loop.last %}, {% endif %}{% endfor %}
            </p>
          {% endif %}
        {% else %}
          <input type="hidden" name="slackShown" value="true">

          <div class="px-4 pt-3">
            <input type="search" x-model="filter" placeholder="Filter" aria-label="Filter Slack conversations" @keydown.enter.prevent
              spellcheck="false" autocapitalize="off" autocomplete="off"
              class="w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
          </div>

          <div class="max-h-96 overflow-y-auto py-2">
            {% for group in slackGroups %}
              {% if group.conversations.length > 0 %}
                <p class="px-4 pt-2 pb-1 text-xs font-medium text-gray-500">{{ group.title }}</p>

                {% for conversation in group.conversations %}
                  <label class="flex items-center gap-3 px-4 py-1.5 cursor-pointer hover:bg-gray-50" data-label="{{ conversation.label }}"
                    x-show="filter === '' || $el.dataset.label.toLowerCase().includes(filter.toLowerCase())">
                    <input type="checkbox" name="slackChannels" value="{{ conversation.id }}" class="size-4 shrink-0 accent-sky-600"
                      {% if conversation.picked %}checked{% endif %}>
                    <span class="min-w-0 text-sm break-words">{{ conversation.label }}</span>
                    {% if conversation.kind == 'private' %}<span class="text-xs text-gray-500">private</span>{% endif %}
                  </label>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </fieldset>

      <fieldset class="bg-white rounded-lg shadow-sm" x-data="ntfyTest">
        <div class="px-4 py-3 border-b border-gray-200">
          <legend class="font-bold">Notifications</legend>
          <p class="mt-0.5 text-xs text-gray-500">Briefings can notify you of something important. Notifications always show on the Notifications page; with an <a href="https://ntfy.sh" target="_blank" rel="noopener" class="underline hover:text-gray-800">ntfy</a> topic here, they're pushed to your phone too. Subscribe to the same topic in the ntfy app.</p>
        </div>

        <div class="px-4 py-3 space-y-3">
          <div>
            <label for="ntfyUrl" class="block text-sm font-medium">ntfy topic URL</label>
            <p class="mt-0.5 mb-1 text-xs text-gray-500">Anyone who knows a topic on ntfy.sh can read it, so pick one that's hard to guess. Leave it empty to keep notifications in rook only.</p>
            <input id="ntfyUrl" x-ref="ntfyUrl" type="url" name="ntfyUrl" value="{{ ntfyUrl or '' }}" placeholder="https://ntfy.sh/your-secret-topic"
              spellcheck="false" autocapitalize="off" autocomplete="off"
              class="w-full p-2 font-mono text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
          </div>

          <div>
            <label for="ntfyToken" class="block text-sm font-medium">Access token <span class="font-normal text-gray-500">(optional)</span></label>
            <p class="mt-0.5 mb-1 text-xs text-gray-500">For a topic that needs logging in to, on your own ntfy server or an ntfy.sh account.</p>
            <input id="ntfyToken" x-ref="ntfyToken" type="password" name="ntfyToken" value="{{ ntfyToken or '' }}"
              spellcheck="false" autocapitalize="off" autocomplete="off"
              class="w-full p-2 font-mono text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50 disabled:opacity-50"
              :disabled="isSending" @click="send()">
              <span class="inline-block size-4 bg-current" :class="isSending ? 'icon-loading' : 'icon-bell'" aria-hidden="true"></span>
              Send a test
            </button>
            <p x-cloak x-show="result" class="text-sm" :class="isOk ? 'text-green-700' : 'text-red-700'" role="status" x-text="result"></p>
          </div>
        </div>
      </fieldset>

      {# Inside the form, so its buttons are plain buttons: a <form method="dialog"> can't go in another form.
         A click on the backdrop lands on the dialog itself, so it cancels. #}
      <dialog x-ref="leaveDialog" class="m-auto w-[calc(100%-2rem)] max-w-md p-0 rounded-lg shadow-xl backdrop:bg-black/30"
        aria-labelledby="leave-dialog-title" @click.self="$el.close()">
        <div class="p-5">
          <h2 id="leave-dialog-title" class="text-base font-bold">Save your changes?</h2>
          <p class="mt-2 text-sm text-gray-600">You have changes to Settings that haven't been saved.</p>

          <div class="mt-5 flex flex-wrap justify-end gap-2">
            <button type="button" class="px-3 py-1.5 text-sm rounded-md hover:bg-gray-100" @click="$refs.leaveDialog.close()">Cancel</button>
            <button type="button" class="px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50" @click="leaveWithoutSaving()">Don't save</button>
            <button type="button" class="px-3 py-1.5 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-md" @click="saveAndLeave()">Save</button>
          </div>
        </div>
      </dialog>
    </form>

    {# Its own form, apart from the settings, so it isn't counted among their unsaved changes #}
    <form method="post" action="/settings/password" class="mt-6 max-w-3xl">
      <fieldset class="bg-white rounded-lg shadow-sm">
        <div class="px-4 py-3 border-b border-gray-200">
          <legend class="font-bold">Password</legend>
          <p class="mt-0.5 text-xs text-gray-500">You log in as {{ ctx.state.user.email }}. A new password needs at least 8 characters.</p>
        </div>

        <div class="px-4 py-3 space-y-3">
          <div>
            <label for="currentPassword" class="block text-sm font-medium">Current password</label>
            <input id="currentPassword" type="password" name="currentPassword" required autocomplete="current-password"
              class="mt-1 w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <div>
              <label for="newPassword" class="block text-sm font-medium">New password</label>
              <input id="newPassword" type="password" name="newPassword" required minlength="8" autocomplete="new-password"
                class="mt-1 w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
            </div>

            <div>
              <label for="confirmPassword" class="block text-sm font-medium">New password again</label>
              <input id="confirmPassword" type="password" name="confirmPassword" required minlength="8" autocomplete="new-password"
                class="mt-1 w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
            </div>
          </div>

          <button type="submit" class="px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50">Change password</button>
        </div>
      </fieldset>
    </form>
  </div>

  <div class="shrink-0 px-4 py-3 sm:px-8 bg-white border-t border-gray-200">
    <div class="max-w-3xl">
      <button type="submit" form="settings-form" class="px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg">Save</button>
    </div>
  </div>
{% endblock body %}
