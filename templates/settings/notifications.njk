{% extends 'layouts/default' %}
{% from 'partials/adminBits' import pageHeader, card, saveBar %}
{% from 'partials/settingsBits' import leaveDialog %}

{# The fields scroll above a bar along the bottom, so Save stays in reach #}
{% block mainClass %}flex flex-col overflow-hidden{% endblock %}

{% block head %}
  {% include 'partials/settingsFormScript' %}
  <script>
    document.addEventListener(`alpine:init`, () => {
      // "Send a test": pushes to the ntfy topic typed in the form, saved or not, without
      // submitting the form, so unsaved changes stay
      Alpine.data(`ntfyTest`, () => ({
        isSending: false,
        result: null,
        isOk: false,

        async send () {
          this.isSending = true
          this.result = null

          try {
            const response = await fetch(`/notifications/test`, {
              method: `POST`,
              headers: { 'Content-Type': `application/json` },
              body: JSON.stringify({ url: this.$refs.ntfyUrl.value, token: this.$refs.ntfyToken.value }),
            })
            const body = await response.json()

            this.isOk = body.ok === true
            this.result = this.isOk ? `Sent. It should be on your phone now.` : `Couldn't send: ${body.error}`
          } catch (err) {
            this.isOk = false
            this.result = `Couldn't send: ${err.message}`
          } finally {
            this.isSending = false
          }
        },
      }))

      // "This computer": desktop pop-ups while rook is open, which only need this browser's
      // permission; nothing is saved on the server (see watchNotifications in layouts/default)
      Alpine.data(`desktopNotify`, () => ({
        // unsupported, insecure, default, granted or denied
        state: `default`,

        init () {
          this.check()
        },

        check () {
          if (typeof Notification === `undefined`) {
            this.state = `unsupported`
          } else if (window.isSecureContext === false) {
            this.state = `insecure`
          } else {
            this.state = Notification.permission
          }
        },

        async turnOn () {
          try {
            await Notification.requestPermission()
          } catch (err) {}

          this.check()
        },

        test () {
          try {
            new Notification(`Rook test notification`, {
              body: `While rook is open, notifications pop up like this.`,
              icon: `/static/icon-192.png?v=2`,
              tag: `rook-test`,
            })
          } catch (err) {}
        },
      }))
    })
  </script>
{% endblock %}

{% block body %}
  <div class="flex-1 min-h-0 overflow-y-auto p-4 sm:p-8">
    {# Written out, not pageHeader, for the link in it #}
    <div class="max-w-3xl">
      <h1 class="text-2xl font-bold">Notifications</h1>
      <p class="mt-1 mb-6 text-sm text-gray-500">Rook notifies you of what's important, and of the reminders you ask for. Notifications always show on the Notifications page; with an <a href="https://ntfy.sh" target="_blank" rel="noopener" class="underline hover:text-gray-800">ntfy</a> topic here, they're pushed to your phone too. They can also pop up on this computer while rook is open.</p>
    </div>

    <form id="settings-form" method="post" action="/settings/notifications" class="space-y-6 max-w-3xl"
      x-data="settingsForm" @input="checkDirty()" @change="checkDirty()" @submit="isLeaving = true">
      {% call card('Your phone', 'Subscribe to the same topic in the ntfy app.') %}
        <div class="space-y-3" x-data="ntfyTest">
          <div>
            <label for="ntfyUrl" class="block text-sm font-medium">ntfy topic URL</label>
            <p class="mt-0.5 mb-1 text-xs text-gray-500">Anyone who knows a topic on ntfy.sh can read it, so pick one that's hard to guess. Leave it empty to keep notifications in Rook only.</p>
            <input id="ntfyUrl" x-ref="ntfyUrl" type="url" name="ntfyUrl" value="{{ ntfyUrl or '' }}" placeholder="https://ntfy.sh/your-secret-topic"
              spellcheck="false" autocapitalize="off" autocomplete="off"
              class="w-full p-2 font-mono text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
          </div>

          <div>
            <label for="ntfyToken" class="block text-sm font-medium">Access token <span class="font-normal text-gray-500">(optional)</span></label>
            <p class="mt-0.5 mb-1 text-xs text-gray-500">For a topic that needs logging in to, on your own ntfy server or an ntfy.sh account.</p>
            <input id="ntfyToken" x-ref="ntfyToken" type="text" name="ntfyToken" value="{{ ntfyToken or '' }}"
              spellcheck="false" autocapitalize="off" autocomplete="off"
              class="w-full p-2 font-mono text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600 [-webkit-text-security:disc]">
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50 disabled:opacity-50"
              :disabled="isSending" @click="send()">
              <span class="inline-block size-4 bg-current" :class="isSending ? 'icon-loading' : 'icon-bell'" aria-hidden="true"></span>
              Send a test
            </button>
            <p x-cloak x-show="result" class="text-sm" :class="isOk ? 'text-green-700' : 'text-red-700'" role="status" x-text="result"></p>
          </div>
        </div>
      {% endcall %}

      {# Not a saved setting: it's this browser's permission, so nothing here makes the form dirty #}
      {% call card('This computer', 'While rook is open, in front or not, notifications pop up on the desktop. When rook is closed, they go to your phone only.') %}
        <div class="space-y-3" x-data="desktopNotify">
          <p x-cloak x-show="state === 'unsupported'" class="text-sm text-gray-700">This browser can't show notifications.</p>
          <p x-cloak x-show="state === 'insecure'" class="text-sm text-gray-700">Browsers only show notifications from a site opened over HTTPS (or on localhost). Open rook at its https:// address to turn them on.</p>
          <p x-cloak x-show="state === 'denied'" class="text-sm text-gray-700">Notifications are blocked for rook in this browser. Allow them in the site settings (the icon beside the address, or the app's menu when installed), then reload this page.</p>

          <div x-cloak x-show="state === 'default'">
            <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50" @click="turnOn()">
              <span class="inline-block size-4 bg-current icon-bell" aria-hidden="true"></span>
              Turn on desktop notifications
            </button>
          </div>

          <div x-cloak x-show="state === 'granted'" class="flex flex-wrap items-center gap-3">
            <p class="text-sm text-green-700">On for this browser.</p>
            <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 text-sm rounded-md border border-gray-300 bg-white hover:bg-gray-50" @click="test()">
              <span class="inline-block size-4 bg-current icon-bell" aria-hidden="true"></span>
              Send a test
            </button>
            <p class="text-xs text-gray-500">To turn them off, block notifications for rook in the browser's site settings.</p>
          </div>
        </div>
      {% endcall %}

      {{ leaveDialog() }}
    </form>
  </div>

  {{ saveBar('settings-form') }}
{% endblock body %}
