{% extends 'layouts/default' %}
{% from 'partials/adminBits' import pageHeader, card %}

{% block body %}
  {{ pageHeader('Password', 'You log in as ' + ctx.state.user.email + '. A new password needs at least ' + passwordMinLength + ' characters.') }}

  <form method="post" action="/settings/password" class="max-w-3xl">
    {% call card('Change password', 'Your current one is asked for, so a browser left logged in can\'t change it.') %}
      <div class="max-w-md space-y-3">
        <div>
          <label for="currentPassword" class="block text-sm font-medium">Current password</label>
          <input id="currentPassword" type="password" name="currentPassword" required autocomplete="current-password"
            class="mt-1 w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
        </div>

        <div>
          <label for="newPassword" class="block text-sm font-medium">New password</label>
          <input id="newPassword" type="password" name="newPassword" required minlength="{{ passwordMinLength }}" autocomplete="new-password"
            class="mt-1 w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
        </div>

        <div>
          <label for="confirmPassword" class="block text-sm font-medium">New password again</label>
          <input id="confirmPassword" type="password" name="confirmPassword" required minlength="{{ passwordMinLength }}" autocomplete="new-password"
            class="mt-1 w-full p-2 text-sm border border-gray-300 rounded-lg focus:ring-0 focus:border-gray-600">
        </div>

        <div class="pt-1">
          <button type="submit" class="px-4 py-2 text-sm font-bold text-white bg-sky-500 hover:bg-sky-600 rounded-lg">Change password</button>
        </div>
      </div>
    {% endcall %}
  </form>
{% endblock body %}
